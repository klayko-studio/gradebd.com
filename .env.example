# Copy to .env and fill in. .env is git-ignored and never copied into an image.
#
#   cp .env.example .env
#
# Generate the two Directus secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── the site ──────────────────────────────────────────────────────────────────
# Canonical origin. Baked in at build time (canonical tags + sitemap), so change
# it and rebuild — not just restart — when you move to a real domain. Directus
# also uses it: it is the origin allowed to be framed by the Visual Editor.
SITE_URL=http://localhost:4321
SITE_PORT=4321

# ── content source ────────────────────────────────────────────────────────────
# Leave DIRECTUS_URL / DIRECTUS_INTERNAL_URL empty and the site builds from the
# seed JSON in src/content — no backend needed, and that is also the fallback if
# Directus is unreachable at request time.
#
# To fill Directus with the site's current content and images in one command:
#
#   docker compose up -d directus
#   npm run directus:bootstrap
#
# It prints a DIRECTUS_TOKEN to paste in below.

# Where the *site's server* reads from.
#   local dev  → http://localhost:8055
#   in compose → leave empty; DIRECTUS_INTERNAL_URL is used instead
DIRECTUS_URL=

# The same thing, over the compose network. docker-compose.yml passes this to
# the site as DIRECTUS_URL.
DIRECTUS_INTERNAL_URL=

# Where a *browser* reaches Directus — the admin's own public origin. Needed for
# in-place editing: it is what the editing script talks to, and setting it is
# what switches visual editing on. Images do NOT use it; they are proxied through
# the site at /cms/<id>, so Directus needs no public read access.
#   production → https://admin.gradebd.com
DIRECTUS_PUBLIC_URL=

# The read-only token the site authenticates with. Printed by the bootstrap.
DIRECTUS_TOKEN=

# Optional. Seconds to hold a Directus response in memory. Zero — the default —
# means an edit is visible on the next reload, which is what in-place editing
# needs. Raise it on a busy box once the content has settled.
DIRECTUS_CACHE_TTL=0

# ── Directus ──────────────────────────────────────────────────────────────────
DIRECTUS_PORT=8055
# Required. Keep these stable: rotating them invalidates sessions and any
# value Directus encrypted with them.
DIRECTUS_KEY=replace-me-32-byte-hex
DIRECTUS_SECRET=replace-me-32-byte-hex
# First-run admin only. Change the password in the UI after logging in once.
# The bootstrap script signs in with these.
DIRECTUS_ADMIN_EMAIL=sales@gradebd.com
DIRECTUS_ADMIN_PASSWORD=replace-me-strong-password

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=gradebd
POSTGRES_USER=gradebd
POSTGRES_PASSWORD=replace-me-strong-password

# ── enquiry notification email ────────────────────────────────────────────────
# Every enquiry is stored in Directus first, so nothing is lost if mail fails.
# Point these at the real mailbox provider before go-live: set EMAIL_TRANSPORT=smtp
# and fill in the host/user/password. Left as sendmail, Directus logs mail instead
# of sending it — an empty SMTP host makes its health endpoint report 503.
EMAIL_TRANSPORT=sendmail
EMAIL_FROM=no-reply@gradebd.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
