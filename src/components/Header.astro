---
import { editable } from '../lib/cms';
import type { Category, Site } from '../lib/schema';

interface Props {
  site: Site;
  categories: Category[];
  active?: 'home' | 'about' | 'categories' | 'gallery' | 'contact';
}

const { site, categories, active } = Astro.props;

/**
 * The menu is CMS-driven for its labels and its order, but never for its
 * destinations: each item names a page and the href is looked up here. A
 * moderator can reword "Product Categories" or move Gallery ahead of it without
 * any possibility of pointing the menu at a URL that does not exist.
 */
const HREF: Record<string, string> = {
  home: '/',
  about: '/about/',
  // The client's "See All / Product Categories should redirect to a new page".
  // It used to point at whichever range came first, which put the menu's most
  // general item on the site's most specific page.
  categories: '/products/',
  gallery: '/gallery/',
  contact: '/contact/',
};

const DEFAULT_NAV = [
  { page: 'home', label: 'Home' },
  { page: 'about', label: 'About Us' },
  { page: 'categories', label: 'Product Categories' },
  { page: 'gallery', label: 'Gallery' },
  { page: 'contact', label: 'Contact' },
];

// An empty nav in the CMS means "nobody has set one up", not "no menu".
const nav = (site.nav.length > 0 ? site.nav : DEFAULT_NAV).map((item) => ({
  key: item.page,
  label: item.label,
  href: HREF[item.page] ?? '/',
}));

/* Nav sits on the client's light blue. Active is ink + a red rule; the rest is
   a deep shade of the same blue, which reads better on the tint than grey. */
const linkBase = 'flex flex-col items-center gap-1.5 t-nav transition-colors';
const linkOn = 'font-semibold text-[color:var(--text-on-menu)]';
const linkOff = 'text-[color:var(--text-on-menu-muted)] hover:text-[color:var(--text-on-menu)]';
---

<header class="sticky top-0 z-40 bg-menu transition-[box-shadow,transform] duration-300" data-header>
  <!-- The bar's height is pinned to the same token the hero subtracts, so the two
       cannot disagree. They did: the bar was ~70px from padding while the mega-menu
       was positioned at 86px, which left a visible gap the pointer had to cross. -->
  <div class="rail flex h-[var(--header-h)] items-center gap-6">
    <a href="/" class="shrink-0" aria-label={`${site.company_name} — home`}>
      <!-- The client's single-colour marks arrived, so the header can simply use the
           red wordmark. This used to be the two-part lockup clipped to hide a white
           tagline that vanished on the light blue — that hack is gone. -->
      {
        site.logo?.src ? (
          <img
            src={site.logo.src}
            alt={site.logo.alt || site.company_name}
            width="140"
            height="36"
            class="block h-9 w-auto"
            {...editable({ collection: 'site', fields: 'logo', mode: 'drawer' })}
          />
        ) : (
          <span class="t-heading-md text-[color:var(--text-on-menu)]">{site.company_name}</span>
        )
      }
    </a>

    <!-- desktop nav -->
    <nav class="ms-auto hidden h-full items-center gap-8 lg:flex" aria-label="Main">
      {
        nav.map((item) =>
          item.key === 'categories' ? (
            <!-- Full bar height, not just the label's. The panel opens at the bar's
                 bottom edge, so a content-height trigger left ~27px of dead space the
                 pointer crossed on the way down — the menu closed under it. Trigger
                 and panel now meet with nothing between them. -->
            <div class="group relative flex h-full items-center">
              <a
                href={item.href}
                aria-current={active === item.key ? 'page' : undefined}
                aria-haspopup="true"
                class:list={[linkBase, 'h-full justify-center', active === item.key ? linkOn : linkOff]}
              >
                {item.label}
                <span
                  class:list={[
                    'h-[2.5px] w-full rounded-full bg-brand transition-opacity',
                    active === item.key ? 'opacity-100' : 'opacity-0',
                  ]}
                />
              </a>

              <!-- Full-width mega-menu, from the client's own reference: one column per
                   range with every sub-category listed. The hover zone spans the
                   trigger and the panel so moving the pointer down does not dismiss it.
                   It is positioned against the header, not this trigger, so it can span
                   the viewport — hence the fixed left/right rather than a width. -->
              <div
                class="invisible fixed left-0 right-0 top-[var(--header-h)] z-50 opacity-0
                       transition-[opacity,visibility] duration-150 group-hover:visible group-hover:opacity-100
                       group-focus-within:visible group-focus-within:opacity-100"
              >
                <div class="border-t border-line-subtle bg-page shadow-[var(--shadow-raised)]">
                  <div class="rail grid gap-7 py-11 lg:grid-cols-5">
                    {
                      categories.map((c) => (
                        <div class="flex flex-col gap-3.5">
                          <span
                            aria-hidden="true"
                            class="h-[3px] w-7 rounded-full"
                            style={`background:${c.accent ?? 'var(--bg-brand)'}`}
                          />
                          <a
                            href={`/${c.slug}/`}
                            class="t-heading-xs text-ink transition-colors hover:text-[color:var(--text-brand-strong)]"
                          >
                            {c.name}
                          </a>
                          {/*
                            Each sub-category opens its range on that tab
                            (`?sub=`, filtered on the server). A range that hides
                            its tabs shows every item on one page, so its
                            sub-categories link to the range itself.
                          */}
                          {c.subcategories.length > 0 && (
                            <ul class="flex flex-col gap-2">
                              {c.subcategories.map((sub) => (
                                <li>
                                  <a
                                    href={c.hide_subcategory_tabs ? `/${c.slug}/` : `/${c.slug}/?sub=${sub.slug}`}
                                    class="t-body-sm text-[color:var(--text-muted)] transition-colors hover:text-[color:var(--text-brand-strong)]"
                                  >
                                    {sub.name}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
              class:list={[linkBase, active === item.key ? linkOn : linkOff]}
            >
              {item.label}
              <span
                class:list={[
                  'h-[2.5px] w-full rounded-full bg-brand transition-opacity',
                  active === item.key ? 'opacity-100' : 'opacity-0',
                ]}
              />
            </a>
          ),
        )
      }
    </nav>

    <div class="ms-auto flex items-center gap-3 lg:ms-8">
      <!-- Search is a secondary action here, so it stays an icon button. It opens
           the full-screen dialog mounted by the layout; `show_search` on the site
           record still decides whether it appears at all. -->
      {site.show_search && (
      <button
        type="button"
        class="flex h-[42px] w-[42px] items-center justify-center rounded-full border
               border-[color:color-mix(in_srgb,var(--text-on-menu-muted)_18%,transparent)]
               bg-[color:color-mix(in_srgb,white_55%,transparent)] transition-colors
               hover:bg-[color:color-mix(in_srgb,white_80%,transparent)]"
        aria-label="Search products"
        data-search-toggle
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="8" stroke="var(--text-on-menu-muted)" stroke-width="2" />
          <path
            d="m21 21-4.3-4.3"
            stroke="var(--text-on-menu-muted)"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
      )}

      <!-- mobile menu -->
      <button
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-full
               border border-[color:color-mix(in_srgb,var(--text-on-menu-muted)_18%,transparent)] lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="relative block h-3 w-5">
          <span
            class="absolute inset-x-0 top-0 h-[2px] bg-[color:var(--text-on-menu)] transition-transform duration-200"
            data-bar="top"></span>
          <span
            class="absolute inset-x-0 bottom-0 h-[2px] bg-[color:var(--text-on-menu)] transition-transform duration-200"
            data-bar="bottom"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- mobile panel -->
  <!-- Capped at the space under the bar and scrollable on its own: the header is
       sticky, so a panel taller than the screen (every range expanded) would
       otherwise run off the bottom with no way to reach the end of it. -->
  <div
    id="mobile-nav"
    hidden
    class="max-h-[calc(100svh-var(--header-h))] overflow-y-auto overscroll-contain
           border-t border-[color:rgb(255_255_255/0.45)] bg-menu lg:hidden"
  >
    <nav class="rail flex flex-col py-2" aria-label="Mobile">
      {
        nav.map((item) => {
          const link = (
            <a
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
              class:list={[
                'block grow py-3.5 t-nav',
                active === item.key
                  ? 'font-semibold text-[color:var(--text-on-menu)]'
                  : 'text-[color:var(--text-on-menu-muted)]',
              ]}
            >
              {item.label}
            </a>
          );
          if (item.key !== 'categories') {
            return <div class="border-b border-[color:rgb(255_255_255/0.45)] last:border-0">{link}</div>;
          }

          /* The phone version of the mega-menu, as two levels of disclosure:
             "Product Categories" opens the ranges, and each range opens its
             sub-categories. The labels stay links — the chevron beside each one
             is the separate control that expands it — so "Product Categories"
             still reaches /products/ and a range still reaches its own page.
             Open on a range page, so the menu starts from where the reader is. */
          const open = active === 'categories';
          return (
            <div class="border-b border-[color:rgb(255_255_255/0.45)] last:border-0">
              <div class="flex items-center gap-2">
                {link}
                <button
                  type="button"
                  class="group -me-2 flex h-11 w-11 shrink-0 items-center justify-center rounded-full
                         text-[color:var(--text-on-menu)]"
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls="mnav-ranges"
                  aria-label={`${open ? 'Hide' : 'Show'} ${item.label}`}
                  data-expand
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                    class="transition-transform duration-200 group-aria-expanded:rotate-180">
                    <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </div>

              {/* Collapses by animating the row track 1fr → 0fr, which reaches the
                  content's real height without measuring it; `inert` while closed
                  keeps the hidden links out of the tab order. */}
              <div
                id="mnav-ranges"
                class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out
                       data-[open]:grid-rows-[1fr]"
                data-open={open ? '' : undefined}
                inert={!open}
              >
                <ul class="flex min-h-0 flex-col overflow-hidden ps-3">
                  {categories.map((c, i) => (
                    <li class:list={[i === categories.length - 1 && 'pb-3']}>
                      <div class="flex items-center gap-2">
                        <a
                          href={`/${c.slug}/`}
                          class="flex grow items-center gap-2.5 py-2 t-label-md text-[color:var(--text-on-menu-muted)]"
                        >
                          <span
                            class="h-2 w-2 shrink-0 rounded-full"
                            style={`background:${c.accent ?? 'var(--bg-brand)'}`}
                          />
                          {c.name}
                        </a>
                        {c.subcategories.length > 0 && (
                          <button
                            type="button"
                            class="group -me-2 flex h-10 w-10 shrink-0 items-center justify-center rounded-full
                                   text-[color:var(--text-on-menu-muted)]"
                            aria-expanded="false"
                            aria-controls={`mnav-${c.slug}`}
                            aria-label={`Show ${c.name} sub-categories`}
                            data-expand
                          >
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                              class="transition-transform duration-200 group-aria-expanded:rotate-180">
                              <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </button>
                        )}
                      </div>
                      {c.subcategories.length > 0 && (
                        <div
                          id={`mnav-${c.slug}`}
                          class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out
                                 data-[open]:grid-rows-[1fr]"
                          inert
                        >
                          {/* Same destinations as the desktop mega-menu: the range on
                              that tab, or the range itself when it hides its tabs. */}
                          <ul class="flex min-h-0 flex-col overflow-hidden ps-[18px]">
                            {c.subcategories.map((sub) => (
                              <li>
                                <a
                                  href={c.hide_subcategory_tabs ? `/${c.slug}/` : `/${c.slug}/?sub=${sub.slug}`}
                                  class="block py-1.5 t-body-sm text-[color:var(--text-on-menu-muted)]"
                                >
                                  {sub.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');
  const top = document.querySelector<HTMLElement>('[data-bar="top"]');
  const bottom = document.querySelector<HTMLElement>('[data-bar="bottom"]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (panel) panel.hidden = open;
    // Morph the two bars into a cross rather than swapping icons.
    if (top) top.style.transform = open ? '' : 'translateY(5px) rotate(45deg)';
    if (bottom) bottom.style.transform = open ? '' : 'translateY(-5px) rotate(-45deg)';
  });

  // The panel's disclosures: each chevron opens the region it names.
  panel?.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((button) => {
    const region = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!region) return;
    const label = button.getAttribute('aria-label') ?? '';
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', label.replace(/^(Show|Hide)/, open ? 'Hide' : 'Show'));
      region.toggleAttribute('data-open', open);
      region.inert = !open;
    });
  });

  /**
   * Hide the bar on the way down, bring it back on the way up.
   *
   * Three guards, each for a real case: nothing happens in the first
   * `--header-h` of scroll, so the bar never flickers away at the top of the
   * page; a movement under 6px is ignored, because trackpad and rubber-band
   * scrolling arrive as a stream of one-pixel jitter in both directions; and it
   * is forced back into view whenever focus lands on something inside it, so
   * tabbing into the nav cannot leave the keyboard on an element that is off
   * screen.
   */
  const bar = document.querySelector<HTMLElement>('[data-header]');
  if (bar) {
    const height = bar.offsetHeight || 86;
    let last = window.scrollY;
    let queued = false;

    const update = () => {
      queued = false;
      const y = window.scrollY;
      const delta = y - last;
      if (Math.abs(delta) < 6) return;

      // The mobile panel is part of the bar: hiding it mid-scroll would take the
      // open menu with it.
      const menuOpen = document.querySelector('[data-menu-toggle]')?.getAttribute('aria-expanded') === 'true';
      bar.classList.toggle('is-hidden', delta > 0 && y > height && !menuOpen);
      last = y;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );

    bar.addEventListener('focusin', () => bar.classList.remove('is-hidden'));
  }
</script>

<style>
  /* Set once the page has scrolled, so the bar reads as sitting above the content.
     Height is deliberately untouched — the hero sizes itself off --header-h. */
  [data-header].is-scrolled {
    box-shadow: 0 10px 30px -12px rgb(10 82 115 / 0.4);
  }

  /* Out of the way going down, back on the way up. Translating rather than
     changing `position` or height: the hero measures itself against --header-h,
     and anything that alters the bar's box would move the fold under it. */
  [data-header].is-hidden {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-header] {
      transition: none;
    }
  }
</style>
