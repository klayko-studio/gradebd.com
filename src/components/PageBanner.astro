---
import Eyebrow from './Eyebrow.astro';
import type { Image } from '../lib/schema';

interface Props {
  eyebrow: string;
  title: string;
  sub: string;
  image: Image;
  /**
   * The client writes banner copy as two or three short lines — "Clear Thoughts /
   * Confident Writing / Endless Possibilities" — not a headline plus paragraph.
   * When lines are present they are the banner; title and sub are the fallback for
   * anything a moderator has not migrated yet.
   */
  lines?: string[];
  /** Category banners carry that range's accent on the eyebrow rule. */
  accent?: string;
}
const { eyebrow, title, sub, image, lines = [], accent } = Astro.props;
const stack = lines.length > 0;
---

<section class="arch-bottom relative isolate overflow-hidden bg-inverse">
  <img
    src={image.src}
    alt={image.alt}
    width={image.width}
    height={image.height}
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <!-- Scrim keeps overlaid type legible whatever photograph a moderator uploads.
       It is a deep shade of the client's own blue — navy is out of this palette. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10"
    style="background:linear-gradient(90deg,rgb(10 82 115 / 0.94) 0%,rgb(10 82 115 / 0.72) 45%,rgb(10 82 115 / 0.30) 78%,rgb(10 82 115 / 0.12) 100%)"
  >
  </div>

  <!-- Full-height banner, with the copy sitting low so it clears the arch. -->
  <div class="h-viewport-minus-header rail flex flex-col justify-end gap-4 py-16 pb-32">
    <Eyebrow tone="dark" accent={accent}>{eyebrow}</Eyebrow>
    {
      stack ? (
        // Three short lines want tight leading and no supporting paragraph — the
        // rhythm of the lines is the message, so anything else dilutes it.
        <h1 class="t-display-lg text-[color:var(--text-inverse)] leading-[0.98] tracking-[-0.01em]">
          {lines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </h1>
      ) : (
        <>
          <h1 class="t-display-lg max-w-[24ch] text-[color:var(--text-inverse)]">{title}</h1>
          <p class="t-body-lg max-w-[58ch] text-[color:var(--text-inverse)]">{sub}</p>
        </>
      )
    }
  </div>
</section>
