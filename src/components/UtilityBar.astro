---
import type { Site } from '../lib/schema';
interface Props {
  site: Site;
}
const { site } = Astro.props;
---

<div class="bg-inverse text-[color:var(--text-inverse-muted)]">
  <div class="rail flex flex-wrap items-center gap-x-6 gap-y-1 py-2.5 t-label-sm">
    <p>{site.utility_message}</p>
    <div class="ms-auto flex items-center gap-4">
      <a
        href={site.phone_href}
        class="text-[color:var(--text-inverse)] transition-colors hover:text-[color:var(--color-red-300)]"
      >
        {site.phone}
      </a>
      <span aria-hidden="true" class="h-3 w-px bg-line-inverse"></span>
      <a
        href={`mailto:${site.email}`}
        class="text-[color:var(--text-inverse)] transition-colors hover:text-[color:var(--color-red-300)]"
      >
        {site.email}
      </a>
    </div>
  </div>
</div>
