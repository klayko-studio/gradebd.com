---
import { socialPaths, socialLabels, socialColours } from '../lib/social-icons';
import type { Site } from '../lib/schema';

/**
 * The row of social buttons. One component so the footer and the Home brand band
 * cannot drift apart — the client asked for the band to match the footer of the
 * other pages.
 */
interface Props {
  socials: Site['socials'];
  /**
   * Which ground the row sits on. The footer is the brand red, so the buttons are
   * drawn in white; the Home band is the light blue, where white would disappear —
   * there the marks take the same deep blue the rest of that section's type uses.
   *
   * `brand` is different in kind: each platform's real logo in its own colour,
   * with no disc and nothing filled behind it. The client wanted the actual
   * marks, not outline substitutes, so the glyph is the whole control — which is
   * why it is drawn larger than the other two tones.
   */
  tone?: 'on-dark' | 'on-light' | 'brand';
  class?: string;
}
const { socials, tone = 'on-dark', class: className = '' } = Astro.props;

/**
 * Only confirmed accounts are linked. Facebook and LinkedIn are the two that exist;
 * the rest are omitted rather than shipped as dead links to a placeholder.
 */
const shown = socials.filter((s) => s.confirmed);

const TONE = {
  'on-light': `border-[color:rgb(13_32_56/0.28)] bg-[color:rgb(255_255_255/0.5)]
     text-[color:var(--text-on-menu)] hover:bg-[color:rgb(255_255_255/0.9)]`,
  'on-dark': `border-[color:rgb(255_255_255/0.38)] bg-[color:rgb(255_255_255/0.14)]
     text-[color:var(--text-inverse)] hover:bg-[color:rgb(255_255_255/0.26)]`,
  // No border, no background: `border` is still in the shared class list below,
  // so the colour has to be cleared rather than simply left unset.
  brand: 'border-transparent bg-transparent hover:-translate-y-0.5 hover:opacity-75',
} as const;

const button = TONE[tone];
const isBrand = tone === 'brand';
/** Brand tone draws each glyph in its own colour; the others inherit the row's. */
const glyph = (platform: string) =>
  isBrand ? (socialColours[platform] ?? 'currentColor') : 'currentColor';
---

{
  shown.length > 0 && (
    <ul class:list={['flex items-center', isBrand ? 'gap-4' : 'gap-2.5', className]}>
      {shown.map((s) => (
        <li>
          <a
            href={s.url}
            aria-label={socialLabels[s.platform] ?? s.platform}
            rel="noopener noreferrer"
            target="_blank"
            class:list={[
              'flex items-center justify-center rounded-full border transition-all duration-200',
              isBrand ? 'h-9 w-9' : 'h-10 w-10',
              button,
            ]}
          >
            <svg
              width={isBrand ? 28 : 17}
              height={isBrand ? 28 : 17}
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d={socialPaths[s.platform]} fill={glyph(s.platform)} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  )
}
