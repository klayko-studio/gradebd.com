---
import type { Image } from '../lib/schema';

interface Props {
  name: string;
  /**
   * The line under the name. Optional: the range cards on Home are just the
   * category name, and an empty one renders nothing rather than a blank line.
   */
  meta?: string;
  image: Image;
  /** Used as the accessible name — the card itself is the control. */
  action: string;
  href?: string;
  /**
   * When set, the card opens that product's detail dialog instead of navigating —
   * the client's "product details on a POP UP". Category cards keep using href.
   */
  dialogId?: string;
  /** Category cards sit shorter than item cards. */
  imageHeight?: 'short' | 'tall';
  /** Range accent shown as a bar above the name. */
  accent?: string;
  /** Directus Visual Editing attributes, from `editable()`. */
  edit?: Record<string, string>;
  /** Extra classes on the card itself — the category page hides filtered cards. */
  class?: string;
  /** Which sub-category this card belongs to, for the tab filter. */
  subcategory?: string | null;
}

const {
  name,
  meta,
  image,
  action,
  href,
  dialogId,
  imageHeight = 'tall',
  accent,
  edit = {},
  class: className = '',
  subcategory,
} = Astro.props;
const ratio = imageHeight === 'short' ? 'aspect-[16/10]' : 'aspect-[4/3]';

/**
 * A card that opens a dialog is a button, not a link — it goes nowhere, and giving
 * it an href would put a fake destination in the status bar and the tab order.
 */
const Tag = dialogId ? 'button' : 'a';
const control = dialogId
  ? { type: 'button' as const, 'data-dialog-open': dialogId }
  : { href };
---

<!-- The client's wireframes put the name ABOVE the photograph, which is also
     how their packaging reads. No image scaling on hover — deliberately. -->
<Tag
  {...control}
  {...edit}
  data-sub={subcategory ?? undefined}
  data-reveal
  aria-label={`${name} — ${action}`}
  class:list={['group flex flex-col gap-1.5 text-left', className]}
>
  {
    accent && (
      <span
        aria-hidden="true"
        class="h-[4px] w-8 rounded-full transition-[width] duration-300 ease-[var(--ease-standard)] group-hover:w-14"
        style={`background:${accent}`}
      />
    )
  }
  <h3 class="t-heading-sm transition-colors group-hover:text-[color:var(--text-brand-strong)]">
    {name}
  </h3>
  {meta && <p class="t-label-sm text-[color:var(--text-muted)]">{meta}</p>}

  <div
    class:list={[
      'relative mt-2 w-full overflow-hidden rounded-sharp border border-line-subtle bg-muted-surface',
      'transition-[border-color,box-shadow] duration-200 ease-[var(--ease-standard)]',
      'group-hover:border-line-brand group-hover:shadow-[var(--shadow-ambient)]',
      ratio,
    ]}
  >
    <img
      src={image.src}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <span
      aria-hidden="true"
      class="absolute bottom-3 right-3 flex h-9 w-9 translate-y-1 items-center justify-center rounded-full
             bg-brand opacity-0 transition-[opacity,transform] duration-200 ease-[var(--ease-standard)]
             group-hover:translate-y-0 group-hover:opacity-100"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <path
          d="M5 12h13M12.5 6.5L18 12l-5.5 5.5"
          stroke="var(--text-on-brand)"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</Tag>
