---
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import type { Site } from '../lib/schema';

interface Props {
  heading: string;
  body: string;
  site: Site;
}
const { heading, body, site } = Astro.props;
---
<!-- Repeats above every footer so no page is a dead end. -->
<section class="section-tight">
  <div class="rail">
    <div
      data-reveal
      class="flex flex-col gap-8 rounded-sharp bg-inverse px-8 py-12 md:flex-row md:items-center md:px-16 md:py-16"
      style="box-shadow:inset 0 1px 0 0 rgb(255 255 255 / 0.10)"
    >
      <div class="flex grow flex-col gap-4">
        <Eyebrow tone="dark">Bulk &amp; wholesale enquiries</Eyebrow>
        <h2 class="t-heading-xl max-w-[26ch] text-[color:var(--text-inverse)]">{heading}</h2>
        <p class="t-body-md max-w-[58ch] text-[color:var(--text-inverse-muted)]">{body}</p>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-3">
        <Button href="/contact/" variant="on-dark">Request a quote</Button>
        <p class="t-label-sm text-[color:var(--text-inverse-muted)]">
          or call <a href={site.phone_href} class="underline decoration-1 underline-offset-2">{site.phone}</a>
          · <a href={`mailto:${site.email}`} class="underline decoration-1 underline-offset-2">{site.email}</a>
        </p>
      </div>
    </div>
  </div>
</section>
