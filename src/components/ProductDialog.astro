---
import type { Item } from '../lib/schema';

/**
 * Product detail dialog — the client's "product details on a POP UP", with the
 * name, the feature bullets as the description, the pack sizes and every image
 * they supply for that SKU.
 *
 * A native <dialog> does the heavy lifting: it gets the top layer, a backdrop, ESC
 * to close and focus trapping without a line of our own code for any of it. The
 * script below only adds thumbnail switching and click-outside-to-close.
 */
interface Props {
  item: Item;
  /** The range's accent, so the dialog is recognisable as part of that category. */
  accent: string;
  /** Category name for the eyebrow. */
  categoryName: string;
}
const { item, accent, categoryName } = Astro.props;

/** Card image first, then any extra views the CMS carries. */
const views = [item.image, ...item.images];
const packLine = [item.pack_inner, item.pack_carton].filter(Boolean).join('  ·  ');
---

<dialog
  id={`dlg-${item.id}`}
  class="product-dialog w-[min(1040px,calc(100vw-2rem))] rounded-[20px] border-0 bg-surface p-0
         text-ink backdrop:bg-[rgb(10_82_115_/_0.55)]"
  aria-labelledby={`dlg-${item.id}-title`}
  data-dialog-accent={accent}
>
  <div class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)]">
    <!-- gallery -->
    <div class="flex flex-col gap-3 bg-soft p-5">
      <img
        src={views[0].src}
        alt={views[0].alt}
        width={views[0].width}
        height={views[0].height}
        class="aspect-[4/3] w-full rounded-xl object-cover"
        data-dialog-main
      />
      {
        views.length > 1 && (
          <div class="flex gap-2.5">
            {views.map((view, i) => (
              <button
                type="button"
                class="aspect-[4/3] min-w-0 flex-1 overflow-hidden rounded-lg border-2 transition-colors"
                style={`border-color:${i === 0 ? accent : 'transparent'}`}
                data-dialog-thumb={view.src}
                data-dialog-thumb-alt={view.alt}
                aria-label={`View ${i + 1} of ${views.length}`}
              >
                <img src={view.src} alt="" class="h-full w-full object-cover" loading="lazy" />
              </button>
            ))}
          </div>
        )
      }
    </div>

    <!-- detail -->
    <div class="flex flex-col gap-5 p-8 md:p-11">
      <div class="flex items-start justify-between gap-6">
        <p class="flex items-center gap-2.5 t-eyebrow text-[color:var(--text-muted)]">
          <span aria-hidden="true" class="h-[3px] w-6 shrink-0 rounded-full" style={`background:${accent}`}
          ></span>
          {categoryName}
        </p>
        <button
          type="button"
          class="grid size-9 shrink-0 place-items-center rounded-full bg-soft text-ink
                 transition-colors hover:bg-[color:var(--border-soft)]"
          data-dialog-close
          aria-label="Close"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M18 6 6 18M6 6l12 12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <h2 id={`dlg-${item.id}-title`} class="t-heading-lg text-balance">{item.name}</h2>

      {
        item.features.length > 0 && (
          <ul class="flex flex-col gap-2.5">
            {item.features.map((feature) => (
              <li class="flex gap-3 t-body-md text-[color:var(--text-secondary)]">
                <span
                  aria-hidden="true"
                  class="mt-[0.55em] size-1.5 shrink-0 rounded-full"
                  style={`background:${accent}`}
                />
                {feature}
              </li>
            ))}
          </ul>
        )
      }

      {
        packLine && (
          <p class="t-label-sm text-[color:var(--text-muted)]">
            {packLine} · price quoted on enquiry
          </p>
        )
      }

      <div class="mt-auto pt-2">
        <a
          href={`/contact/?item=${encodeURIComponent(item.name)}`}
          class="group inline-flex items-center gap-3 rounded-full bg-brand px-6 py-3.5 t-button
                 text-[color:var(--text-on-brand)] transition-transform hover:-translate-y-px"
        >
          Enquire about this item
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-1"
          >
            <path
              d="M5 12h14M13 5l7 7-7 7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</dialog>

<style>
  /**
   * A native <dialog> centres itself with `margin: auto`, which the CSS reset
   * zeroes out — without this the panel pins to the top-left corner.
   */
  .product-dialog {
    margin: auto;
    max-height: calc(100dvh - 3rem);
    overflow: auto;
    box-shadow: 0 28px 64px rgb(4 10 16 / 0.34);
  }
  .product-dialog[open] {
    animation: dialog-in 180ms var(--ease-standard);
  }
  .product-dialog::backdrop {
    backdrop-filter: blur(2px);
  }
  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-dialog[open] {
      animation: none;
    }
  }
</style>
