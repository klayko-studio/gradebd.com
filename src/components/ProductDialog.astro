---
import type { Item } from '../lib/schema';

/**
 * Product detail dialog — the client's "product details on a POP UP", with the
 * name, the feature bullets as the description, the pack sizes and every image
 * they supply for that SKU.
 *
 * A native <dialog> does the heavy lifting: it gets the top layer, a backdrop, ESC
 * to close and focus trapping without a line of our own code for any of it. The
 * page's script adds thumbnail switching, click-outside-to-close, and opening the
 * full-screen viewer from the main image.
 */
interface Props {
  item: Item;
  /** The range's accent, so the dialog is recognisable as part of that category. */
  accent: string;
  /** Category name for the eyebrow. Empty renders no eyebrow at all. */
  categoryName?: string;
}
const { item, accent, categoryName } = Astro.props;

/**
 * Card image first, then any extra stills, then any footage.
 *
 * Videos go last on purpose: a reader opening a product wants to see the thing
 * before they watch it, and the dialog opens on whatever is first. Both kinds
 * share one strip and one viewer, so a video is another view of the product
 * rather than a second gallery to build and keep in step.
 */
const views = [
  ...[item.image, ...item.images].map((view) => ({ ...view, kind: 'image' as const })),
  ...item.videos.map((view) => ({ ...view, kind: 'video' as const })),
];

/**
 * "Pack Size — 12 Pcs Paper Box" with the carton quantity on its own line
 * underneath, which is what the client asked for: where an item has two kinds of
 * pack, the carton figure is a separate fact and reads as one when it is beside
 * the inner pack rather than below it.
 */
const packLines = [item.pack_inner, item.pack_carton].filter(Boolean);
---

<dialog
  id={`dlg-${item.id}`}
  class="product-dialog w-[min(1040px,calc(100vw-2rem))] rounded-[20px] border-0 bg-page p-0
         text-ink backdrop:bg-[rgb(10_82_115_/_0.55)]"
  aria-labelledby={`dlg-${item.id}-title`}
  data-dialog-accent={accent}
  data-views={JSON.stringify(
    views.map((view) => ({
      src: view.src,
      alt: view.alt,
      type: view.kind,
      // A video opens on the card photograph rather than on black, which is what
      // the frame shows until enough of the file has arrived to decode one.
      ...(view.kind === 'video' ? { poster: item.image.src } : {}),
    })),
  )}
>
  <div class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)]">
    <!-- gallery: thumbnails in a column down the left of the main image, the way
         a product page usually reads. The strip only appears from the second
         image on, so a single-photo SKU gets the full width for it. -->
    <div class="flex gap-3 bg-subtle p-5">
      {
        views.length > 1 && (
          <div class="flex w-[58px] shrink-0 flex-col gap-2.5 md:w-[68px]">
            {/*
              A video thumbnail shows the card photograph, not a frame of the
              file: a <video> here would have every product's footage fetching
              its metadata on first paint just to draw a first frame, across
              every dialog on the page.
            */}
            {views.map((view, i) => (
              <button
                type="button"
                class="relative aspect-square w-full overflow-hidden rounded-lg border-2 bg-page transition-colors"
                style={`border-color:${i === 0 ? accent : 'transparent'}`}
                data-dialog-thumb
                data-dialog-view={i}
                aria-label={
                  view.kind === 'video'
                    ? `Play video ${i + 1} of ${views.length}`
                    : `View ${i + 1} of ${views.length}`
                }
              >
                <img
                  src={view.kind === 'video' ? item.image.src : view.src}
                  alt=""
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                {view.kind === 'video' && (
                  <span
                    aria-hidden="true"
                    class="absolute inset-0 grid place-items-center bg-[color:rgb(6_20_28/0.28)]"
                  >
                    <span class="grid size-6 place-items-center rounded-full bg-[color:rgb(255_255_255/0.94)] text-[color:var(--text-primary)]">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5.2v13.6a.6.6 0 0 0 .91.51l11.2-6.8a.6.6 0 0 0 0-1.02L8.91 4.69A.6.6 0 0 0 8 5.2Z" />
                      </svg>
                    </span>
                  </span>
                )}
              </button>
            ))}
          </div>
        )
      }
      <!-- The main image is a control, not a picture: pressing it hands this SKU's
           photographs to the page's viewer, which opens over this dialog. Modal
           dialogs stack in the top layer, so the one opened last is the one on
           top and the one ESC closes — no z-index and no hiding this panel. -->
      <button
        type="button"
        class="group relative min-w-0 flex-1 cursor-zoom-in self-start overflow-hidden rounded-xl"
        data-dialog-zoom
        aria-label={`View ${item.name} images full screen`}
      >
        <img
          src={views[0].src}
          alt={views[0].alt}
          width={views[0].width}
          height={views[0].height}
          class="aspect-[4/3] w-full rounded-xl object-cover transition-transform duration-500
                 ease-[var(--ease-standard)] group-hover:scale-[1.03]"
          data-dialog-main
        />
        <span
          aria-hidden="true"
          class="zoom-badge absolute bottom-3 right-3 grid size-9 translate-y-1 place-items-center rounded-full
                 bg-[color:rgb(10_82_115/0.72)] text-white opacity-0 transition-[opacity,transform]
                 duration-200 ease-[var(--ease-standard)] group-hover:translate-y-0
                 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
            <path d="M11 8v6M8 11h6M20 20l-3.8-3.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>

        {/*
          Shown only while a video is the selected view. It replaces the
          magnifier rather than joining it — pressing the frame then plays the
          footage instead of enlarging a still, and two different promises on one
          control is one too many.
        */}
        <span
          aria-hidden="true"
          class="play-badge absolute inset-0 place-items-center bg-[color:rgb(6_20_28/0.22)]"
        >
          <span
            class="grid size-14 place-items-center rounded-full bg-[color:rgb(255_255_255/0.94)]
                   text-[color:var(--text-primary)] shadow-[0_6px_20px_rgb(4_10_16/0.28)]
                   transition-transform duration-300 ease-[var(--ease-standard)] group-hover:scale-110"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5.2v13.6a.6.6 0 0 0 .91.51l11.2-6.8a.6.6 0 0 0 0-1.02L8.91 4.69A.6.6 0 0 0 8 5.2Z" />
            </svg>
          </span>
        </span>
      </button>
    </div>

    <!-- detail -->
    <div class="flex flex-col gap-5 p-8 md:p-11">
      <div class="flex items-start justify-between gap-6">
        {/* The category eyebrow is not rendered: the client asked for it off every
            item in every category. `categoryName` is still passed in, so putting
            it back is a few lines rather than a rewire. */}
        {/* ms-auto, not justify-between: with nothing beside it the close button
            would otherwise slide to the left of the panel. */}
        <button
          type="button"
          class="ms-auto grid size-9 shrink-0 place-items-center rounded-full bg-subtle text-ink
                 transition-colors hover:bg-[color:var(--border-soft)]"
          data-dialog-close
          aria-label="Close"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M18 6 6 18M6 6l12 12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <h2 id={`dlg-${item.id}-title`} class="t-heading-lg text-balance">{item.name}</h2>

      {
        item.features.length > 0 && (
          <ul class="flex flex-col gap-2.5">
            {item.features.map((feature) => (
              <li class="flex gap-3 t-body-md text-[color:var(--text-secondary)]">
                <span
                  aria-hidden="true"
                  class="mt-[0.55em] size-1.5 shrink-0 rounded-full"
                  style={`background:${accent}`}
                />
                {feature}
              </li>
            ))}
          </ul>
        )
      }

      {
        packLines.length > 0 && (
          <div class="flex flex-col gap-1.5">
            {/*
              Set to the client's own mock: the display serif, larger than the
              feature bullets above it, with "Pack Size" as a label beside a list
              of the packs rather than a run-in prefix.

              The label and the list are siblings in a flex row, which is what
              lines the dashes up under each other — the alternative, repeating
              "Pack Size" or padding the second line with spaces, either says it
              twice or breaks the moment the type size changes.
            */}
            <p class="flex items-baseline gap-2 font-display t-body-lg text-ink">
              <span class="shrink-0">Pack Size</span>
              <span class="flex flex-col">
                {packLines.map((line) => (
                  <span>- {line}</span>
                ))}
              </span>
            </p>
          </div>
        )
      }

    </div>
  </div>
</dialog>

<style>
  /**
   * The play overlay is off until the script selects a video view.
   *
   * A `hidden` attribute would not have done it: `[hidden]` sets `display: none`
   * at the lowest possible weight and any display utility on the same element
   * beats it, so the badge would have sat over every product photograph.
   */
  .play-badge {
    display: none;
  }
  .play-badge.is-on {
    display: grid;
  }
  /* One promise per control: with the play badge up, the magnifier goes. The
     script toggles this, because the magnifier is the earlier sibling and CSS
     has no way to look backwards from the badge that supersedes it. */
  .zoom-badge.is-off {
    display: none;
  }

  /**
   * A native <dialog> centres itself with `margin: auto`, which the CSS reset
   * zeroes out — without this the panel pins to the top-left corner.
   */
  .product-dialog {
    margin: auto;
    max-height: calc(100dvh - 3rem);
    overflow: auto;
    box-shadow: 0 28px 64px rgb(4 10 16 / 0.34);
  }
  .product-dialog[open] {
    animation: dialog-in 180ms var(--ease-standard);
  }
  .product-dialog::backdrop {
    backdrop-filter: blur(2px);
  }
  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-dialog[open] {
      animation: none;
    }
  }
</style>
