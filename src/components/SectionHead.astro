---
import Eyebrow from './Eyebrow.astro';
interface Props {
  eyebrow: string;
  heading: string;
  tone?: 'light' | 'dark';
  class?: string;
}
const { eyebrow, heading, tone = 'light', class: className = '' } = Astro.props;
---
<div class:list={['flex flex-col gap-4', className]}>
  <Eyebrow tone={tone} data-reveal>{eyebrow}</Eyebrow>
  <h2 class:list={['t-heading-xl max-w-[38ch]', tone === 'dark' && 'text-[color:var(--text-inverse)]']} data-reveal>
    {heading}
  </h2>
  <slot />
</div>
