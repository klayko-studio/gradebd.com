---
import type { Gallery } from '../lib/schema';

/**
 * Full-screen viewer for the gallery.
 *
 * One dialog for the whole page rather than one per plate: the images are large,
 * and thirty copies of the same markup to show one at a time is thirty times the
 * DOM for no gain. The plates carry their own data and the script fills this in.
 *
 * A native <dialog> again — top layer, backdrop, ESC and focus trapping for free.
 * What is added here is the part it does not do: arrow keys, prev/next, a counter,
 * and preloading the neighbours so stepping through is instant.
 */
interface Props {
  images: Gallery['images'];
}
const { images } = Astro.props;
---

<dialog id="gallery-lightbox" class="lightbox border-0 bg-transparent p-0" aria-label="Gallery viewer">
  <div
    class="relative flex h-full w-full flex-col items-center justify-center gap-4 p-4 md:p-8"
    data-lightbox-backdrop
  >
    <!-- The close and step controls sit above the picture on every size, so they
         never end up over the image on a narrow screen. -->
    <div class="flex w-full max-w-[1200px] shrink-0 items-center justify-between gap-4">
      <p class="t-label-sm text-[color:rgb(255_255_255/0.9)]">
        <span data-lightbox-index>1</span> / {images.length}
      </p>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full bg-[color:rgb(255_255_255/0.16)]
               text-white transition-colors hover:bg-[color:rgb(255_255_255/0.3)]"
        data-lightbox-close
        aria-label="Close viewer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>

    <div class="flex min-h-0 w-full max-w-[1200px] flex-1 items-center gap-3 md:gap-5">
      <button
        type="button"
        class="grid size-11 shrink-0 place-items-center rounded-full bg-[color:rgb(255_255_255/0.16)]
               text-white transition-colors hover:bg-[color:rgb(255_255_255/0.3)] md:size-14"
        data-lightbox-prev
        aria-label="Previous image"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M15 18 9 12l6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      <img
        src=""
        alt=""
        class="min-h-0 w-full flex-1 rounded-sharp object-contain"
        style="max-height:calc(100dvh - 12rem)"
        data-lightbox-image
      />

      <button
        type="button"
        class="grid size-11 shrink-0 place-items-center rounded-full bg-[color:rgb(255_255_255/0.16)]
               text-white transition-colors hover:bg-[color:rgb(255_255_255/0.3)] md:size-14"
        data-lightbox-next
        aria-label="Next image"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m9 18 6-6-6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <!-- Not a <figcaption>: there is no <figure> here, and the caption belongs to
         whichever plate is showing rather than to fixed markup. -->
    <p
      class="flex w-full max-w-[1200px] shrink-0 flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center"
    >
      <span class="t-label-md text-white" data-lightbox-caption></span>
      <span class="t-label-xs text-[color:rgb(255_255_255/0.7)]" data-lightbox-tag></span>
    </p>
  </div>
</dialog>

<style>
  /* Fills the viewport rather than sitting in the middle of it: this is a viewer,
     not a panel. `margin: 0` because the reset zeroes the auto-centring a dialog
     normally does, and here we want the corners anyway. */
  .lightbox {
    margin: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
  }
  .lightbox::backdrop {
    background: rgb(6 20 28 / 0.92);
  }
  .lightbox[open] {
    animation: lightbox-in 160ms var(--ease-standard);
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] {
      animation: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#gallery-lightbox');
  const plates = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-plate]'));

  if (dialog && plates.length > 0) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const tag = dialog.querySelector<HTMLElement>('[data-lightbox-tag]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-index]')!;

    /** Read straight off the plates, so the viewer cannot list something the page does not show. */
    const slides = plates.map((plate) => ({
      src: plate.dataset.plateSrc ?? '',
      alt: plate.dataset.plateAlt ?? '',
      caption: plate.dataset.plateCaption ?? '',
      tag: plate.dataset.plateTag ?? '',
    }));

    let current = 0;

    /** Warm the neighbours so stepping through does not flash an empty frame. */
    function preload(index: number) {
      for (const offset of [-1, 1]) {
        const neighbour = slides[(index + offset + slides.length) % slides.length];
        if (neighbour) new Image().src = neighbour.src;
      }
    }

    function show(index: number) {
      current = (index + slides.length) % slides.length;
      const slide = slides[current];
      image.src = slide.src;
      image.alt = slide.alt;
      caption.textContent = slide.caption;
      tag.textContent = slide.tag;
      counter.textContent = String(current + 1);
      preload(current);
    }

    plates.forEach((plate, index) => {
      plate.addEventListener('click', () => {
        show(index);
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });

    // Clicking the dark area closes. Anything interactive is a button, so a click
    // that lands on the dialog itself or its padding wrapper is a click on nothing.
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.dataset.lightboxBackdrop !== undefined) dialog.close();
    });

    // Returning focus to the plate that was opened keeps the keyboard where the
    // reader left it, which closing a dialog does not do on its own.
    dialog.addEventListener('close', () => plates[current]?.focus());
  }
</script>
