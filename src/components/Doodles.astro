---
/**
 * Decorative stationery line-art, in the spirit of the client's own geometry-box
 * artwork. Icons are from Lucide (ISC). Purely ornamental, so the layer is
 * aria-hidden and never intercepts a pointer.
 */
interface Props {
  /** Stroke colour — pass a token, not a literal. */
  color?: string;
  /** Kept low: this is texture, not pattern. */
  opacity?: number;
  class?: string;
}
const { color = 'currentColor', opacity = 0.09, class: className = '' } = Astro.props;

const D: Record<string, string> = {
  ruler:
    'M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z M14.5 12.5l2-2 M11.5 9.5l2-2 M8.5 6.5l2-2 M17.5 15.5l2-2',
  paperclip:
    'm16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551',
  compass:
    'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z m4.24 5.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z',
  pencil:
    'M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z M15 5l4 4',
  scissors:
    'M9 6a3 3 0 1 0-6 0 3 3 0 0 0 6 0Z M8.12 8.12 12 12 M20 4 8.12 15.88 M9 18a3 3 0 1 0-6 0 3 3 0 0 0 6 0Z M14.8 14.8 20 20',
  cap: 'M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z M22 10v6 M6 12.5V16a6 3 0 0 0 12 0v-3.5',
  shapes:
    'M8.3 10a.7.7 0 0 1-.626-1.079L11.4 3a.7.7 0 0 1 1.198-.043L16.3 8.9a.7.7 0 0 1-.572 1.1Z M10 15a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h5a1 1 0 0 0 1-1z M21 17.5a3.5 3.5 0 1 0-7 0 3.5 3.5 0 0 0 7 0Z',
  note: 'M21 9a2.4 2.4 0 0 0-.706-1.706l-3.588-3.588A2.4 2.4 0 0 0 15 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2z M15 3v5a1 1 0 0 0 1 1h5',
};

/**
 * left%, top%, size, icon, rotation — generated from a fixed seed so the texture is
 * identical on every build. The client asked for the backdrop to be "more and more":
 * 42 marks at 16–26px rather than a dozen at 36–64px.
 */
const KEYS = Object.keys(D) as (keyof typeof D)[];
let seed = 20260824;
const rnd = () => {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  return seed / 0x7fffffff;
};
const cells: [number, number][] = [];
for (let r = 0; r < 6; r++) for (let c = 0; c < 7; c++) cells.push([c, r]);
for (let i = cells.length - 1; i > 0; i--) {
  const j = Math.floor(rnd() * (i + 1));
  [cells[i], cells[j]] = [cells[j], cells[i]];
}
const placed: [number, number, number, keyof typeof D, number][] = cells.map(([c, r], i) => [
  Math.round((c * (100 / 7) + rnd() * 8) * 100) / 100,
  Math.round((r * (100 / 6) + rnd() * 6) * 100) / 100,
  16 + Math.round(rnd() * 10),
  KEYS[i % KEYS.length],
  Math.round(rnd() * 30 - 15),
]);
---

<div
  class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`}
  aria-hidden="true"
  data-doodles
>
  {
    placed.map(([left, top, size, key, rotate]) => (
      <svg
        width={size}
        height={size}
        viewBox="0 0 24 24"
        fill="none"
        class="absolute"
        style={`left:${left}%;top:${top}%;opacity:${opacity};transform:rotate(${rotate}deg)`}
      >
        {D[key].split(' M').map((seg, i) => (
          <path
            d={i === 0 ? seg : `M${seg}`}
            stroke={color}
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        ))}
      </svg>
    ))
  }
</div>
