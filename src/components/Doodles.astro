  ],
  star: [
    'M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z',
  ],
};

const KEYS = Object.keys(D);

/**
 * Three sizes, not one flat scatter — a field of one size at one opacity is what
 * the client called barely visible, and simply turning the opacity up would have
 * made it wallpaper. The range is what does the work.
 *
 * Note the big marks are the *faintest*, not the boldest. A large mark lays down
 * several times the ink of a small one, so matching their opacities makes the
 * large shapes shout and swamp the address block they pass behind. Fading them
 * back evens out the ink per mark: the big ones read as soft forms in the
 * distance, the small ones as the sharp detail in front. Stroke weight is graded
 * the same way, because a stroke is in viewBox units and scales with the mark.
 *
 * The order matches what the motion layer reads — it takes its parallax depth
 * from `i % 3` — so the marks that drift furthest on scroll are the near ones.
 *
 * `size` is a percentage of the mark's own cell, not a pixel value: see the grid
 * note below. The ceiling is 70 because a square rotated 22 degrees needs about
 * 1.3x its own width, and 70 x 1.3 still clears the cell.
 */
const PLANES = [
  { min: 52, span: 22, alpha: 0.5, stroke: 1.5 }, // far — large, soft
  { min: 38, span: 14, alpha: 0.8, stroke: 1.9 }, // mid
  { min: 26, span: 12, alpha: 1, stroke: 2.3 }, // near — small, crisp
];

/**
 * Cells, not marks. Roughly a fifth are left empty: one mark per cell with no
 * gaps reads as a lattice rather than a scatter, and the eye picks up the rows
 * immediately. The holes are what make it look strewn.
 */
const CELLS = 118;
const BLANK = 0.19;

// Fixed seed, so the texture is identical on every build rather than reshuffling.
let seed = 20260827;
const rnd = () => {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  return seed / 0x7fffffff;
};

const round = (n: number) => Math.round(n * 100) / 100;
const marks = Array.from({ length: CELLS }, (_, i) => {
  if (rnd() < BLANK) return null;
  const plane = PLANES[i % PLANES.length];
  const size = round(plane.min + rnd() * plane.span);
  /**
   * Whatever the mark does not use of its cell, it may wander into — so the small
   * marks drift furthest and the large ones barely move, which is the opposite of
   * a fixed jitter and reads far less regular.
   *
   * The awkward `/ size` is because a percentage in `translate()` is a share of
   * the element's *own* box, not of the cell it sits in. A flat 8% therefore
   * moved the big marks further than the small ones, which is backwards, and it
   * let a few of them cross into the next cell. 1.32 is the width a square needs
   * once it is turned 22 degrees; what is left over, halved, is the play on each
   * side — converted here from a share of the cell to a share of the mark.
   */
  const slack = Math.min(70, Math.max(0, (50 * (100 - size * 1.32)) / size));
  return {
    size,
    alpha: round(opacity * plane.alpha * (0.82 + rnd() * 0.36)),
    stroke: plane.stroke,
    key: KEYS[Math.floor(rnd() * KEYS.length)],
    rotate: Math.round(rnd() * 44 - 22),
    nudge: [round((rnd() * 2 - 1) * slack), round((rnd() * 2 - 1) * slack)],
  };
});
---

<!--
  A grid, not a field of absolutely-positioned marks. Percentage coordinates
  cannot know the shape of the box they land in: the footer is roughly 5:1, so a
  16x6 grid of percentages gave cells about 90px wide and 48px tall, and any mark
  drawn larger than 48px overlapped its neighbours no matter how the numbers were
  tuned. Giving each mark its own cell and sizing it as a fraction of that cell
  makes overlap impossible at any viewport, and the column count follows the
  width on its own.
-->
<div
  class={`doodle-field pointer-events-none absolute inset-0 overflow-hidden ${className}`}
  aria-hidden="true"
  data-doodles
>
  {
    marks.map((m) =>
      m === null ? (
        <span />
      ) : (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        preserveAspectRatio="xMidYMid meet"
        style={`width:${m.size}%;height:${m.size}%;opacity:${m.alpha};transform:translate(${m.nudge[0]}%,${m.nudge[1]}%) rotate(${m.rotate}deg)`}
      >
        {D[m.key].map((d) => (
          <path
            d={d}
            stroke={color}
            stroke-width={m.stroke}
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        ))}
      </svg>
      ),
    )
  }
</div>

<style>
  /* `auto-fill` sets the column count from the width, and `1fr` rows share the
     height between however many rows that leaves — so the same 96 marks spread
     wide and shallow across a desktop footer and narrow and deep on a phone.

     The min track is `min(84px, 16%)` rather than a flat 84px because the count
     is fixed: on a phone a flat 84px leaves four columns and therefore twenty-four
     rows, and the cells come out three times wider than they are tall. Letting the
     track shrink to a share of the width keeps them near enough square at any
     size, which is what stops rotated marks reaching each other. */
  .doodle-field {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(84px, 16%), 1fr));
    grid-auto-rows: 1fr;
    place-items: center;
  }
</style>
