const KEYS = Object.keys(D);

/**
 * Three planes, not one flat scatter — a field of one size at one opacity is what
 * the client called barely visible, and simply turning the opacity up would have
 * made it wallpaper. The range is what does the work.
 *
 * Note the big marks are the *faintest*, not the boldest. A 64px mark lays down
 * several times the ink of a 22px one, so matching their opacities makes the
 * large shapes shout and swamp the address block they pass behind. Fading them
 * back evens out the ink per mark: the big ones read as soft forms in the
 * distance, the small ones as the sharp detail in front. Stroke weight is graded
 * the same way, because a stroke is in viewBox units and scales with the mark.
 *
 * The order matches what the motion layer reads — it takes its parallax depth
 * from `i % 3` — so the marks that drift furthest on scroll are the near ones.
 */
const PLANES = [
  { min: 46, span: 22, alpha: 0.5, stroke: 1.5 }, // far — large, soft
  { min: 30, span: 14, alpha: 0.8, stroke: 1.9 }, // mid
  { min: 20, span: 10, alpha: 1, stroke: 2.3 }, // near — small, crisp
];

const COLS = 16;
const ROWS = 6;

// Fixed seed, so the texture is identical on every build rather than reshuffling.
let seed = 20260827;
const rnd = () => {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  return seed / 0x7fffffff;
};

const cells: [number, number][] = [];
for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) cells.push([c, r]);
for (let i = cells.length - 1; i > 0; i--) {
  const j = Math.floor(rnd() * (i + 1));
  [cells[i], cells[j]] = [cells[j], cells[i]];
}

const round = (n: number) => Math.round(n * 100) / 100;
const marks = cells.map(([c, r], i) => {
  const plane = PLANES[i % PLANES.length];
  return {
    left: round(c * (100 / COLS) + rnd() * (100 / COLS)),
    top: round(r * (100 / ROWS) + rnd() * (100 / ROWS)),
    size: plane.min + Math.round(rnd() * plane.span),
    // A little jitter per mark, so no two neighbours read as a matched pair.
    alpha: round(opacity * plane.alpha * (0.82 + rnd() * 0.36)),
    stroke: plane.stroke,
    key: KEYS[Math.floor(rnd() * KEYS.length)],
    rotate: Math.round(rnd() * 44 - 22),
  };
});
---

<div
  class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`}
  aria-hidden="true"
  data-doodles
>
  {
    marks.map((m) => (
      <svg
        width={m.size}
        height={m.size}
        viewBox="0 0 24 24"
        fill="none"
        class="absolute"
        style={`left:${m.left}%;top:${m.top}%;opacity:${m.alpha};transform:translate(-50%,-50%) rotate(${m.rotate}deg)`}
      >
        {D[m.key].map((d) => (
          <path
            d={d}
            stroke={color}
            stroke-width={m.stroke}
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        ))}
      </svg>
    ))
  }
</div>
