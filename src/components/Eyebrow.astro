---
interface Props {
  /** Dark sections need the lighter red for contrast. */
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className = '' } = Astro.props;
const colour = tone === 'dark' ? 'text-[color:var(--color-red-300)]' : 'text-[color:var(--text-brand-strong)]';
---
<p class:list={['flex items-center gap-3 t-eyebrow', colour, className]}>
  <span aria-hidden="true" class="h-[2px] w-6 shrink-0 bg-brand"></span>
  <slot />
</p>
