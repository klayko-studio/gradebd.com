---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'on-dark' | 'on-red';
  type?: 'button' | 'submit';
  class?: string;
  /** Trailing arrow advances on hover, matching the Figma button. */
  arrow?: boolean;
}

/**
 * Anything else passed in lands on the rendered tag. That is what lets a caller
 * attach Directus' `editable()` attributes to the button itself rather than to a
 * wrapper around it — the visual editor draws its hit area from the element that
 * carries them, so on a wrapper the overlay is a box around the button instead
 * of the button.
 */
const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  arrow = true,
  ...rest
} = Astro.props;

const base =
  'group inline-flex items-center gap-3 rounded-sharp px-6 py-4 t-button transition-colors duration-200 ' +
  'ease-[var(--ease-standard)] disabled:opacity-60 disabled:pointer-events-none';

const variants: Record<string, string> = {
  primary: 'bg-brand text-[color:var(--text-on-brand)] hover:bg-brand-hover',
  secondary:
    'bg-page text-ink border border-line hover:border-line-strong hover:bg-subtle',
  /**
   * Hero only, and deliberately identical to the slider's prev/next controls —
   * the client approved those and asked for this to follow them. Same deep-blue
   * ground at 22%, same hairline white border, same 2px blur, so the three
   * controls in the hero read as one set rather than a white pill beside two
   * glass circles. White ink, because a 22% ground is far too see-through to
   * carry dark type.
   */
  'on-dark':
    'border border-white/50 bg-[color:rgb(10_82_115/0.22)] text-white backdrop-blur-[2px] ' +
    'hover:border-white hover:bg-[color:rgb(10_82_115/0.5)]',
  /**
   * The same glass treatment as `on-dark`, tinted red instead of blue — for the
   * footer, which is a red band rather than a photograph. The tint is red/900,
   * the deepest step of the same ramp the footer itself is a shade of, so it
   * reads as the band going darker rather than as a second colour laid over it.
   * Exactly the relationship `on-dark` has with the deep blue.
   */
  'on-red':
    'border border-white/50 bg-[color:rgb(125_13_20/0.32)] text-white backdrop-blur-[2px] ' +
    'hover:border-white hover:bg-[color:rgb(125_13_20/0.62)]',
};

const arrowColour = variant === 'secondary' ? 'var(--text-primary)' : 'currentColor';
const Tag = href ? 'a' : 'button';
---

<Tag
  {...href ? { href } : { type }}
  {...rest}
  class:list={[base, variants[variant], className]}
>
  <span><slot /></span>
  {
    arrow && (
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        class="transition-transform duration-200 ease-[var(--ease-standard)] group-hover:translate-x-1"
      >
        <path
          d="M5 12h13M12.5 6.5L18 12l-5.5 5.5"
          stroke={arrowColour}
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</Tag>
