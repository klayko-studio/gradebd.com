---
import Button from './Button.astro';
import type { Home } from '../lib/schema';

interface Props {
  slides: Home['slides'];
  /**
   * Editing targets the slide list as a whole rather than each slide's copy:
   * only one slide is on screen at a time, so per-slide hit areas would sit on
   * top of each other in the overlay.
   */
  edit?: Record<string, string>;
}
const { slides, edit = {} } = Astro.props;

/**
 * Slides are siblings in one flex column with all but the current one `hidden`,
 * so only the visible slide is in flow and the block is centred on its own
 * height. A slide without a button is therefore shorter than one with it, and
 * the copy jumps between slides — worst on a short viewport, where the missing
 * 60-odd pixels read as a reflow rather than a nudge.
 *
 * Every slide that has no button gets an invisible one holding the space, so
 * the copy block is the same height on all six whatever a moderator switches
 * on or off. Unconditional on purpose: the reserved row is part of the hero's
 * height budget, so it cannot appear and disappear with the content either.
 */
---

<section
  class="h-viewport-minus-header relative isolate flex flex-col overflow-hidden bg-inverse"
  {...edit}
  data-slider
  aria-roledescription="carousel"
  aria-label="Product ranges"
>
  {
    slides.map((slide, i) => (
      <div
        class="absolute inset-0 -z-10"
        data-slide-media={i}
        aria-hidden={i === 0 ? undefined : 'true'}
        style={i === 0 ? 'opacity:1' : 'opacity:0'}
      >
        {/*
          `object-cover`, so every slide fills the frame edge to edge.

          This was briefly `contain` with a blurred copy behind it, to answer the
          client's "the rest are exceeding the viewport height" — the frame is
          about 2:1 and the photographs are nearer 1.4:1, so covering it discards
          roughly 30% of each one's height. Showing them whole fixed that but left
          each slide a different width against a blurred surround, which the
          client liked less than the crop. Reverted deliberately, and the real fix
          is with them: a 2400x1200 photograph covers this frame exactly, with
          nothing cropped and no filler.
        */}
        <img
          src={slide.image.src}
          alt={slide.image.alt}
          width={slide.image.width}
          height={slide.image.height}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          class="h-full w-full object-cover"
          style={i === 0 ? 'transform:scaleX(-1)' : undefined}
        />
      </div>
    ))
  }

  <!-- The scrim the headline sits on. Dark at the left where the copy is, clear
       at the right so the photograph is not dimmed for nothing. Its darkest stop
       came down from 0.93 to 0.72 on the client's "reduce the opacity" note.

       It lives between the photographs and the copy on purpose, and it was lost
       once in a careless revert that replaced the block it sat inside — which
       dropped the headline's contrast to about 1.4:1. If it disappears again,
       that is where it went. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10"
    style="background:linear-gradient(90deg,rgb(10 82 115 / 0.72) 0%,rgb(10 82 115 / 0.44) 45%,rgb(10 82 115 / 0.12) 78%,rgb(10 82 115 / 0) 100%)"
  >
  </div>

  <!--
    Header + hero add up to exactly one viewport, so the whole slide is visible
    without scrolling.

    The height belongs to the <section>, not to this block. It used to sit here,
    with the controls as a sibling underneath — so the hero came to one viewport
    *plus* the controls, and the bottom 76px of every slide sat below the fold at
    every screen size. That is the client's "still need to scroll down to see the
    full image". Now the copy takes the space that is left after the controls.
  -->
  {/*
    The vertical padding is measured against the viewport's HEIGHT, which is the
    whole point. It was a flat `py-16` — 128px of it — and that is what pushed
    the next/prev row below the fold on a short screen: the hero's height is
    `100svh - header`, but everything inside it was sized against the viewport's
    width, so at 1280x600 the content came to 550px inside a 514px box.

    `clamp(1rem, 7svh, 4rem)` keeps the full 4rem on a normal laptop and gives it
    back as the window gets short. Combined with the reserved button row above,
    all six slides are the same height AND all six fit — the two instructions
    that looked like they pulled against each other.
  */}
  <div class="rail flex min-h-0 flex-1 flex-col justify-center py-[clamp(1rem,7svh,4rem)]">
    {
      slides.map((slide, i) => (
        <div
          class:list={['flex max-w-[46rem] flex-col gap-5', i === 0 ? '' : 'hidden']}
          data-slide-copy={i}
          role="group"
          aria-label={`${i + 1} of ${slides.length}: ${slide.label}`}
        >
          {/* Nothing in the field, nothing on the page — not even the rule. */}
          {slide.eyebrow && (
            <p class="flex items-center gap-3 t-eyebrow text-[color:var(--text-inverse)]">
              <span aria-hidden="true" class="h-[2px] w-6 shrink-0 bg-brand" />
              {slide.eyebrow}
            </p>
          )}
          {slide.lines.length > 0 ? (
            // The client's slide copy is a three-line phrase — "Every Tool / Every
            // Dream / Endless Potential". Tight leading keeps it reading as one unit.
            <h1 class="hero-headline t-display-2xl text-[color:var(--text-inverse)] leading-[0.98] tracking-[-0.01em]">
              {slide.lines.map((line) => (
                // Each line sits in its own clipping box so the motion layer can slide
                // it up from behind its own edge rather than fading it in place.
                <span class="block overflow-hidden pb-[0.06em]">
                  <span class="block" data-anim-line>
                    {line}
                  </span>
                </span>
              ))}
            </h1>
          ) : (
            <>
              <h1 class="hero-headline t-display-2xl text-[color:var(--text-inverse)]">{slide.headline}</h1>
              <p class="t-body-lg max-w-[54ch] text-[color:var(--text-inverse-muted)]">{slide.body}</p>
            </>
          )}
          {/*
            Per-slide, from the CMS. A slide whose copy is the whole message —
            "Every Tool / Every Dream / Endless Potential" — can be worse for a
            button under it, so `show_cta` is a switch a moderator owns rather
            than something only a developer can change. The range link is
            separate and still follows range_slug.
          */}
          {slide.show_cta || slide.range_slug ? (
            <div class="mt-2 flex flex-wrap items-center gap-4">
              {slide.show_cta && (
                <Button href="/contact/" variant="primary">
                  Request a quote
                </Button>
              )}
              {slide.range_slug && (
                <Button href={`/${slide.range_slug}/`} variant="on-dark">
                  View the range
                </Button>
              )}
            </div>
          ) : (
            /*
              A real button rather than a fixed height, so the space matches
              whatever the button actually measures — at any breakpoint, and
              after any change to its padding or type. `visibility: hidden`
              keeps it in flow while taking it out of the tab order and out of
              the accessibility tree, which `opacity: 0` would not.
            */
            <div class="mt-2 flex flex-wrap items-center gap-4 invisible" aria-hidden="true">
              <Button variant="on-dark">View the range</Button>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <!-- controls -->
  <div class="rail relative z-10 flex shrink-0 flex-wrap items-center gap-5 pb-8">
    <!-- "01 / 06 — ALL ITEMS" is gone, on the client's instruction. The dots stay:
         they are the control, not a caption, and they are the only thing that
         says how many slides there are. -->
    {/*
      No gap: each dot's own padding separates it now, and doubling up would push
      the row into the arrows on a phone.
    */}
    <div class="flex items-center" role="tablist" aria-label="Choose slide">
      {/*
        The rule people see is 3px tall; the thing they tap is the button around
        it. As one element it measured 28x3 and 8x3 — visually right, and on a
        touch screen effectively unhittable. Now 24x43, which clears WCAG 2.5.8's
        24x24 floor.

        The padding is transparent, but it is not free: it replaced the row's
        8px gap, so the dots sit 16px apart rather than 8. `px-2` is the least
        that still clears the floor, which keeps that change as small as it can
        be — anything tighter buys back a few pixels of spacing and gives up the
        target again.
      */}
      {
        slides.map((slide, i) => (
          <button
            type="button"
            role="tab"
            data-slide-dot={i}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={slide.label}
            class="group flex items-center px-2 py-5"
          >
            <span
              aria-hidden="true"
              data-slide-rule
              class:list={[
                'block h-[3px] rounded-full transition-all duration-300',
                i === 0 ? 'w-7 bg-brand' : 'w-2 bg-white/35 group-hover:bg-white/60',
              ]}
            />
          </button>
        ))
      }
    </div>

    <div class="ms-auto flex items-center gap-2">
      <button
        type="button"
        data-slide-prev
        aria-label="Previous slide"
        class="flex h-14 w-14 items-center justify-center rounded-sharp border border-white/50
               bg-[color:rgb(10_82_115/0.22)] text-white backdrop-blur-[2px] transition-colors
               hover:border-white hover:bg-[color:rgb(10_82_115/0.5)]"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button
        type="button"
        data-slide-next
        aria-label="Next slide"
        class="flex h-14 w-14 items-center justify-center rounded-sharp border border-white/50
               bg-[color:rgb(10_82_115/0.22)] text-white backdrop-blur-[2px] transition-colors
               hover:border-white hover:bg-[color:rgb(10_82_115/0.5)]"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-slider]');
  if (root) {
    // Captured so the nested functions below keep the non-null narrowing.
    const slider = root;
    const media = [...root.querySelectorAll<HTMLElement>('[data-slide-media]')];
    const copies = [...root.querySelectorAll<HTMLElement>('[data-slide-copy]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-slide-dot]')];
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const reduced = motion.matches;

    let current = 0;
    let busy = false;

    function show(next: number) {
      next = (next + media.length) % media.length;
      if (next === current || busy) return;
      busy = true;

      const from = current;
      current = next;

      // Crossfade the photograph, and lift the copy in — the copy is what the
      // buyer reads, so it gets the movement rather than the image.
      const duration = reduced ? 0 : 0.55;
      gsap.to(media[from], { opacity: 0, duration, ease: 'power2.out' });
      gsap.to(media[next], { opacity: 1, duration, ease: 'power2.out' });
      media[from].setAttribute('aria-hidden', 'true');
      media[next].removeAttribute('aria-hidden');

      copies[from].classList.add('hidden');
      copies[next].classList.remove('hidden');
      if (!reduced) {
        gsap.fromTo(
          copies[next].children,
          { opacity: 0, y: 18 },
          { opacity: 1, y: 0, duration: 0.5, stagger: 0.05, ease: 'power3.out' },
        );
      }

      dots.forEach((dot, i) => {
        const active = i === next;
        dot.setAttribute('aria-selected', String(active));
        // The width and colour live on the rule inside the button now, because
        // the button itself is the (much larger) hit area.
        const rule = dot.querySelector('[data-slide-rule]');
        rule?.classList.toggle('w-7', active);
        rule?.classList.toggle('bg-brand', active);
        rule?.classList.toggle('w-2', !active);
        rule?.classList.toggle('bg-white/35', !active);
      });

      // Let the motion layer re-run the line reveal for the slide now on screen.
      slider.dispatchEvent(new CustomEvent('slide:change', { detail: { index: next } }));

      window.setTimeout(() => {
        busy = false;
      }, reduced ? 0 : 560);
    }

    /**
     * Auto-advance, on the same terms as the client row further down the page.
     *
     * Paused while the pointer is over the hero or the keyboard is inside it: a
     * slide that changes out from under someone reading the headline, or tabbing
     * to the range link, is worse than one that never moves on its own. Skipped
     * under prefers-reduced-motion, and while the tab is in the background, where
     * the timer would otherwise queue up transitions to replay all at once on
     * return.
     *
     * 3s, on the client's instruction. It was 6.5s, on the reasoning that this
     * is three lines of display type and a button rather than a strip of marks
     * to glance at, so it should be readable at a normal reading pace before it
     * moves. They want it faster; that is their call and this is the one number
     * to change if it turns out to be too quick to read.
     */
    const DELAY = 3000;
    let timer: number | undefined;
    let onScreen = true;

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (motion.matches || document.hidden || !onScreen) return;
      timer = window.setInterval(() => show(current + 1), DELAY);
    };

    /** Every deliberate move restarts the clock, so an automatic one never treads on it. */
    const go = (to: number) => {
      show(to);
      start();
    };

    root.querySelector('[data-slide-next]')?.addEventListener('click', () => go(current + 1));
    root.querySelector('[data-slide-prev]')?.addEventListener('click', () => go(current - 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    // Keyboard support for the tablist.
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') go(current + 1);
      if (event.key === 'ArrowLeft') go(current - 1);
    });

    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    motion.addEventListener('change', start);

    /* Once the reader has scrolled past, there is nothing to advance for — and
       each change crossfades a full-screen photograph and re-runs the headline
       reveal, which is real work to be doing off-screen. */
    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        start();
      },
      { threshold: 0.25 },
    ).observe(root);

    start();
  }
</script>

<style>
  /**
   * The headline is the last thing in the hero still sized purely against the
   * viewport's WIDTH — `t-display-2xl` is `clamp(2.75rem, 5.4vw, 4.5rem)`. On a
   * short, wide window that is three lines of 69px type inside a 474px box, and
   * it is what was left pushing the controls under the fold once the padding
   * had been dealt with.
   *
   * `min(5.4vw, 9svh)` caps it by height as well. The numbers are chosen so
   * nothing changes where nothing was wrong: at 1440x800 and above the cap is
   * already the binding one, and the 2.75rem floor is untouched, so every phone
   * — where 5.4vw is tiny and the floor governs — renders exactly as before.
   * Only a short desktop window moves.
   *
   * Scoped here rather than changed in `global.css` because this is the hero's
   * problem: a page banner using the same token sits in a box that grows with
   * its content and has no fold to fall under.
   */
  .hero-headline {
    font-size: clamp(2.75rem, min(5.4vw, 9svh), 4.5rem);
  }
</style>
