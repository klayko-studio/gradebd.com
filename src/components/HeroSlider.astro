---
import Button from './Button.astro';
import type { Home } from '../lib/schema';

interface Props {
  slides: Home['slides'];
  /**
   * Editing targets the slide list as a whole rather than each slide's copy:
   * only one slide is on screen at a time, so per-slide hit areas would sit on
   * top of each other in the overlay.
   */
  edit?: Record<string, string>;
}
const { slides, edit = {} } = Astro.props;
---

<section
  class="h-viewport-minus-header relative isolate flex flex-col overflow-hidden bg-inverse"
  {...edit}
  data-slider
  aria-roledescription="carousel"
  aria-label="Product ranges"
>
  {
    slides.map((slide, i) => {
      /**
       * The picture's own shape, handed to the stylesheet rather than applied
       * here, because whether it is used at all depends on the shape of the
       * window — see the note on `.slide-photo`. Guarded, because a file with no
       * stored dimensions would otherwise produce `--photo-ratio: /`.
       */
      const shape =
        slide.image.width && slide.image.height
          ? `--photo-ratio:${slide.image.width}/${slide.image.height}`
          : null;

      return (
      <div
        class="absolute inset-0 -z-10"
        data-slide-media={i}
        aria-hidden={i === 0 ? undefined : 'true'}
        style={i === 0 ? 'opacity:1' : 'opacity:0'}
      >
        {/*
          Two copies of the same file, and no second download — the browser has
          it cached by the time the second tag asks.

          The frame is one viewport minus the header, which comes out near 2:1 on
          a laptop. `object-cover` on its own therefore threw away 29-31% of the
          height of any photograph narrower than that, which is what the client
          saw as the slides "exceeding the viewport height": the first slide
          happened to be a wide shot and survived, the rest were cut in half.

          So the photograph is `object-contain` — all of it, never cropped — and
          a blurred, over-scaled copy fills whatever is left either side. A shot
          that is already 2:1 covers the frame exactly and the layer behind it is
          never seen; a narrower one is shown whole against its own colours
          instead of black bars. `aria-hidden` on the filler: it is the same
          picture, and a screen reader should hear the alt text once.
        */}
        <img
          src={slide.image.src}
          alt=""
          aria-hidden="true"
          loading={i === 0 ? 'eager' : 'lazy'}
          class="absolute inset-0 h-full w-full scale-110 object-cover blur-2xl"
          style={i === 0 ? 'transform:scaleX(-1) scale(1.1)' : undefined}
        />
        <div class="slide-photo absolute inset-0" style={shape}>
          <img
            src={slide.image.src}
            alt={slide.image.alt}
            width={slide.image.width}
            height={slide.image.height}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            class="h-full w-full"
            style={i === 0 ? 'transform:scaleX(-1)' : undefined}
          />
        </div>
      </div>
      );
    })
  }

  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10"
    style="background:linear-gradient(90deg,rgb(10 82 115 / 0.72) 0%,rgb(10 82 115 / 0.44) 45%,rgb(10 82 115 / 0.12) 78%,rgb(10 82 115 / 0) 100%)"
  >
  </div>

  <!--
    Header + hero add up to exactly one viewport, so the whole slide is visible
    without scrolling.

    The height belongs to the <section>, not to this block. It used to sit here,
    with the controls as a sibling underneath — so the hero came to one viewport
    *plus* the controls, and the bottom 76px of every slide sat below the fold at
    every screen size. That is the client's "still need to scroll down to see the
    full image". Now the copy takes the space that is left after the controls.
  -->
  <div class="rail flex min-h-0 flex-1 flex-col justify-center py-16">
    {
      slides.map((slide, i) => (
        <div
          class:list={['flex max-w-[46rem] flex-col gap-5', i === 0 ? '' : 'hidden']}
          data-slide-copy={i}
          role="group"
          aria-label={`${i + 1} of ${slides.length}: ${slide.label}`}
        >
          {/* Nothing in the field, nothing on the page — not even the rule. */}
          {slide.eyebrow && (
            <p class="flex items-center gap-3 t-eyebrow text-[color:var(--text-inverse)]">
              <span aria-hidden="true" class="h-[2px] w-6 shrink-0 bg-brand" />
              {slide.eyebrow}
            </p>
          )}
          {slide.lines.length > 0 ? (
            // The client's slide copy is a three-line phrase — "Every Tool / Every
            // Dream / Endless Potential". Tight leading keeps it reading as one unit.
            <h1 class="t-display-2xl text-[color:var(--text-inverse)] leading-[0.98] tracking-[-0.01em]">
              {slide.lines.map((line) => (
                // Each line sits in its own clipping box so the motion layer can slide
                // it up from behind its own edge rather than fading it in place.
                <span class="block overflow-hidden pb-[0.06em]">
                  <span class="block" data-anim-line>
                    {line}
                  </span>
                </span>
              ))}
            </h1>
          ) : (
            <>
              <h1 class="t-display-2xl text-[color:var(--text-inverse)]">{slide.headline}</h1>
              <p class="t-body-lg max-w-[54ch] text-[color:var(--text-inverse-muted)]">{slide.body}</p>
            </>
          )}
          {/*
            Per-slide, from the CMS. A slide whose copy is the whole message —
            "Every Tool / Every Dream / Endless Potential" — can be worse for a
            button under it, so `show_cta` is a switch a moderator owns rather
            than something only a developer can change. The range link is
            separate and still follows range_slug.
          */}
          {(slide.show_cta || slide.range_slug) && (
            <div class="mt-2 flex flex-wrap items-center gap-4">
              {slide.show_cta && (
                <Button href="/contact/" variant="primary">
                  Request a quote
                </Button>
              )}
              {slide.range_slug && (
                <Button href={`/${slide.range_slug}/`} variant="on-dark">
                  View the range
                </Button>
              )}
            </div>
          )}
        </div>
      ))
    }
  </div>

  <!-- controls -->
  <div class="rail relative z-10 flex shrink-0 flex-wrap items-center gap-5 pb-8">
    <!-- "01 / 06 — ALL ITEMS" is gone, on the client's instruction. The dots stay:
         they are the control, not a caption, and they are the only thing that
         says how many slides there are. -->
    <div class="flex items-center gap-2" role="tablist" aria-label="Choose slide">
      {
        slides.map((slide, i) => (
          <button
            type="button"
            role="tab"
            data-slide-dot={i}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={slide.label}
            class:list={[
              'h-[3px] rounded-full transition-all duration-300',
              i === 0 ? 'w-7 bg-brand' : 'w-2 bg-white/35 hover:bg-white/60',
            ]}
          ></button>
        ))
      }
    </div>

    <div class="ms-auto flex items-center gap-2">
      <button
        type="button"
        data-slide-prev
        aria-label="Previous slide"
        class="flex h-14 w-14 items-center justify-center rounded-sharp border border-white/50
               bg-[color:rgb(10_82_115/0.22)] text-white backdrop-blur-[2px] transition-colors
               hover:border-white hover:bg-[color:rgb(10_82_115/0.5)]"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button
        type="button"
        data-slide-next
        aria-label="Next slide"
        class="flex h-14 w-14 items-center justify-center rounded-sharp border border-white/50
               bg-[color:rgb(10_82_115/0.22)] text-white backdrop-blur-[2px] transition-colors
               hover:border-white hover:bg-[color:rgb(10_82_115/0.5)]"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  /**
   * Whether the photograph is shown whole or cropped depends on the shape of the
   * window, not on the device width.
   *
   * On anything landscape the frame is wider than the photographs, so containing
   * one costs a little width at the sides and keeps every bit of its height —
   * which is the fix the client asked for. On a phone the frame is *portrait*
   * (390x694, about 0.56:1), and a landscape photograph contained inside it fell
   * to 41% of the height with blurred bands above and below. That is further
   * from "fullscreen" than the crop it replaced, so a narrow window keeps
   * `cover`.
   *
   * 3/2 rather than 1/1 as the threshold: at 1:1 a 2:1 photograph still only
   * reaches half the height. Every laptop lands well past it — 1440x800 gives a
   * 2.02 frame, 1366x640 gives 2.47 — and so does a landscape tablet.
   */
  .slide-photo img {
    object-fit: cover;
  }

  @media (min-aspect-ratio: 3/2) {
    .slide-photo {
      margin: auto;
      aspect-ratio: var(--photo-ratio);
      max-width: 100%;
      max-height: 100%;

      /*
       * Feathers the photograph's left and right edges into the blurred copy
       * behind it, so the two do not meet at a hard vertical line. It has to be
       * on this box and not on the <img>: `object-fit` moves the picture inside
       * the element without moving the element, so a mask on the image faded the
       * frame's edges and left the seam exactly where it was.
       *
       * 28px at the outermost edge, where no subject is ever placed, and it
       * fades rather than clips. On a picture already 2:1 the fade lands on a
       * blurred copy of the same pixels and cannot be seen.
       */
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 28px,
        #000 calc(100% - 28px),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 28px,
        #000 calc(100% - 28px),
        transparent 100%
      );
    }

    .slide-photo img {
      object-fit: contain;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-slider]');
  if (root) {
    // Captured so the nested functions below keep the non-null narrowing.
    const slider = root;
    const media = [...root.querySelectorAll<HTMLElement>('[data-slide-media]')];
    const copies = [...root.querySelectorAll<HTMLElement>('[data-slide-copy]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-slide-dot]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current = 0;
    let busy = false;

    function show(next: number) {
      next = (next + media.length) % media.length;
      if (next === current || busy) return;
      busy = true;

      const from = current;
      current = next;

      // Crossfade the photograph, and lift the copy in — the copy is what the
      // buyer reads, so it gets the movement rather than the image.
      const duration = reduced ? 0 : 0.55;
      gsap.to(media[from], { opacity: 0, duration, ease: 'power2.out' });
      gsap.to(media[next], { opacity: 1, duration, ease: 'power2.out' });
      media[from].setAttribute('aria-hidden', 'true');
      media[next].removeAttribute('aria-hidden');

      copies[from].classList.add('hidden');
      copies[next].classList.remove('hidden');
      if (!reduced) {
        gsap.fromTo(
          copies[next].children,
          { opacity: 0, y: 18 },
          { opacity: 1, y: 0, duration: 0.5, stagger: 0.05, ease: 'power3.out' },
        );
      }

      dots.forEach((dot, i) => {
        const active = i === next;
        dot.setAttribute('aria-selected', String(active));
        dot.classList.toggle('w-7', active);
        dot.classList.toggle('bg-brand', active);
        dot.classList.toggle('w-2', !active);
        dot.classList.toggle('bg-white/35', !active);
      });

      // Let the motion layer re-run the line reveal for the slide now on screen.
      slider.dispatchEvent(new CustomEvent('slide:change', { detail: { index: next } }));

      window.setTimeout(() => {
        busy = false;
      }, reduced ? 0 : 560);
    }

    root.querySelector('[data-slide-next]')?.addEventListener('click', () => show(current + 1));
    root.querySelector('[data-slide-prev]')?.addEventListener('click', () => show(current - 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    // Keyboard support for the tablist.
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') show(current + 1);
      if (event.key === 'ArrowLeft') show(current - 1);
    });
  }
</script>
