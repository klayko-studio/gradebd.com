---
import SocialLinks from './SocialLinks.astro';
import type { Site } from '../lib/schema';

/**
 * The light blue band that closes the home page — the client's own doodle
 * artwork beside a line about the buying year. It mirrors the Champ geometry
 * box: their blue, their illustration.
 *
 * This is where Home's social links live. The client asked for them here instead
 * of a second "Request a quote", which the hero already carries; Home is also the
 * one page whose footer deliberately has no social row (comment #9), so without
 * this the site's only page with no social links anywhere would be the front one.
 */
interface Props {
  /** Optional: an empty one is not rendered at all. */
  eyebrow?: string;
  heading: string;
  /** Optional: the section is the social row, so it does not always need a lead-in. */
  body?: string;
  socials: Site['socials'];
}
const { eyebrow, heading, body, socials } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-menu">
  <!-- Copy sits above the artwork and is held to the left half on wide screens,
       so the two never overlap however long the heading runs. -->
  <div class="rail relative z-10 py-14 lg:py-20">
    <div class="flex max-w-[34ch] flex-col gap-4 md:max-w-[46%]">
      {eyebrow && <p class="t-eyebrow text-[color:var(--text-on-menu-muted)]">{eyebrow}</p>}
      <h2 class="t-heading-xl text-[color:var(--text-on-menu)]">{heading}</h2>
      {body && <p class="t-body-md max-w-[46ch] text-[color:var(--text-on-menu-muted)]">{body}</p>}
      <!-- The client asked for the real logos here rather than a one-colour row, so
           each mark keeps its own brand colour on a white disc. -->
      <SocialLinks socials={socials} tone="brand" class="mt-3" />
    </div>
  </div>

  <!--
    Client-supplied artwork. Licence unverified — see readme before go-live.

    Anchored to the bottom-right corner and pushed a little past it, so the
    illustration reads as coming *out of* the corner rather than sitting in a box
    beside the text. The tilt turns around `origin-bottom-right`, which keeps that
    corner pinned while the top of the drawing swings — rotating about the centre
    would lift it off the edge and reopen the gap the anchoring just closed.

    Absolute only from `md` up. On a phone there is no room beside the copy, so it
    falls back to a plain block underneath, where it is a picture rather than a
    background.
  -->
  <img
    src="/images/brand/doodles.png"
    alt=""
    aria-hidden="true"
    width="1600"
    height="1067"
    loading="lazy"
    decoding="async"
    class="pointer-events-none mx-auto block w-full max-w-[520px] select-none
           md:absolute md:right-0 md:bottom-0 md:z-0 md:mx-0 md:w-[clamp(360px,54vw,900px)]
           md:max-w-none md:origin-bottom-right md:translate-x-[6%] md:translate-y-[8%]
           md:rotate-[-11deg]"
  /></section>
