---
import type { Category, Site } from '../lib/schema';

interface Props {
  site: Site;
  categories: Category[];
}
const { site, categories } = Astro.props;

/** Only the confirmed accounts are linked; the rest are omitted rather than
 *  shipped as dead links to a placeholder. */
const socials = site.socials.filter((s) => s.confirmed);

const paths: Record<string, string> = {
  facebook: 'M13.6 21v-8h2.5l.4-2.9h-2.9V8.3c0-.85.24-1.43 1.46-1.43h1.55V4.28c-.27-.04-1.2-.11-2.28-.11-2.26 0-3.8 1.38-3.8 3.91v2.02H8v2.9h2.49V21h3.11z',
  linkedin:
    'M6.7 9H4.2v11.8h2.5V9zM5.45 4.2a1.55 1.55 0 100 3.1 1.55 1.55 0 000-3.1zM20.3 20.8h-2.5v-6.1c0-1.5-.53-2.4-1.83-2.4-1.03 0-1.6.7-1.87 1.37-.1.24-.12.58-.12.92v6.21H11.5s.03-10.4 0-11.8h2.48v1.67c.33-.51 1.15-1.44 2.77-1.44 2.01 0 3.55 1.31 3.55 4.14v7.43z',
};
const labels: Record<string, string> = { facebook: 'Facebook', linkedin: 'LinkedIn' };
---

<footer class="bg-inverse text-[color:var(--text-inverse-muted)]">
  <div class="rail grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1.2fr]">
    <div class="flex flex-col gap-5">
      <!-- Navy is the only ground where the supplied lockup reads in full,
           tagline included, so the footer uses the complete artwork. -->
      <img
        src="/images/brand/grade-logo.png"
        alt={`${site.company_name} — ${site.tagline}`}
        width="190"
        height="68"
        class="w-[190px]"
      />
      <p class="t-body-sm max-w-[34ch]">
        Supplying pens, exercise books and office stationery to businesses across Bangladesh since {
          site.founded_year
        }.
      </p>
      {
        socials.length > 0 && (
          <ul class="flex items-center gap-2.5">
            {socials.map((s) => (
              <li>
                <a
                  href={s.url}
                  aria-label={labels[s.platform] ?? s.platform}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-line-inverse
                         transition-colors hover:border-[color:var(--color-red-400)]"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={paths[s.platform]} fill="currentColor" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav aria-labelledby="f-products" class="flex flex-col gap-4">
      <h2 id="f-products" class="t-label-xs text-[color:var(--text-inverse)]">Products</h2>
      <ul class="flex flex-col gap-3 t-body-sm">
        {
          categories.map((c) => (
            <li>
              <a href={`/${c.slug}/`} class="transition-colors hover:text-[color:var(--text-inverse)]">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="f-company" class="flex flex-col gap-4">
      <h2 id="f-company" class="t-label-xs text-[color:var(--text-inverse)]">Company</h2>
      <ul class="flex flex-col gap-3 t-body-sm">
        <li><a href="/about/" class="transition-colors hover:text-[color:var(--text-inverse)]">About Us</a></li>
        <li><a href="/about/#vision" class="transition-colors hover:text-[color:var(--text-inverse)]">Our Vision</a></li>
        <li><a href="/gallery/" class="transition-colors hover:text-[color:var(--text-inverse)]">Gallery</a></li>
        <li><a href="/#clients" class="transition-colors hover:text-[color:var(--text-inverse)]">Corporate Clients</a></li>
      </ul>
    </nav>

    <div class="flex flex-col gap-4">
      <h2 class="t-label-xs text-[color:var(--text-inverse)]">Get in touch</h2>
      <address class="flex flex-col gap-3 t-body-sm not-italic">
        {site.address_lines.map((line) => <span>{line}</span>)}
        <a href={site.phone_href} class="transition-colors hover:text-[color:var(--text-inverse)]">
          {site.phone}
        </a>
        <a href={`mailto:${site.email}`} class="transition-colors hover:text-[color:var(--text-inverse)]">
          {site.email}
        </a>
        <span class="text-[color:var(--color-navy-300)]">{site.opening_hours}</span>
      </address>
    </div>
  </div>

  <div class="bg-inverse-soft">
    <div class="rail flex flex-wrap items-center justify-between gap-2 py-5 t-label-sm">
      <p>© {new Date().getFullYear()} {site.company_name}. All rights reserved.</p>
      <p>B2B supplier · Dhanmondi, Dhaka</p>
    </div>
  </div>
</footer>
