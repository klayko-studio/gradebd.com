---
import { editable } from '../lib/cms';
import Doodles from './Doodles.astro';
import SocialLinks from './SocialLinks.astro';
import { socialPaths } from '../lib/social-icons';
import type { Category, Site } from '../lib/schema';

interface Props {
  site: Site;
  categories: Category[];
  /**
   * The client wants social icons everywhere except Home ("Social Media wont be
   * available on Home Page only"), so the layout passes this in per page.
   */
  showSocials?: boolean;
}
const { site, categories, showSocials = true } = Astro.props;

const link = 'transition-opacity hover:opacity-70';

/**
 * wa.me wants digits only, and it wants the *international* number.
 * `phone` is the local form the client prints — 01842-024378 — which would send
 * WhatsApp looking for a number in whatever country the reader happens to be in.
 * `phone_href` carries the dialable form (tel:+8801842024378), so that is the one
 * to strip; the local number is only a fallback if nobody has filled it in.
 */
const dialable = site.phone_href.replace(/[^0-9]/g, '') || site.phone.replace(/[^0-9]/g, '');
const whatsapp = `https://wa.me/${dialable}`;

/**
 * The footer sits on the red band, so it needs a reversed mark. Prefer the one
 * carrying "Stationary" — the client's own artwork for comment #22 — and fall
 * back through the plain reversed lockup before giving up and setting the
 * company name in type.
 */
const footerLogo = site.logo_reversed_stationary ?? site.logo_reversed ?? null;
---

<footer class="relative overflow-hidden bg-footer text-[color:var(--text-inverse)]">
  <Doodles color="#ffffff" opacity={0.3} />

  <div class="rail relative grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1.2fr]">
    <div class="flex flex-col gap-5">
      <!-- The client's reversed lockup, which carries "Stationary" as artwork — this
           is comment #22 delivered properly, replacing the version we set in type
           while waiting for it. The tagline is not part of the mark, so it stays as
           a line of type beneath.

           The explicit `items-center` matters for more than the alignment the client
           asked for: this is a flex column, and the default `align-items: stretch`
           pulls a `w-auto` image out to the full column width, which with the
           height pinned stretches the mark to more than twice its aspect. Any
           value other than `stretch` will do — centring is the one they wanted. -->
      <div class="flex flex-col items-center gap-2 text-center">
        {
          footerLogo?.src ? (
            <img
              src={footerLogo.src}
              alt={footerLogo.alt || site.company_name}
              width="196"
              height="61"
              class="block h-[52px] w-auto self-center"
              {...editable({ collection: 'site', fields: 'logo_reversed_stationary', mode: 'drawer' })}
            />
          ) : (
            /* No mark uploaded: the company name still has to appear. */
            <span class="t-heading-md text-[color:var(--text-inverse)]">{site.company_name}</span>
          )
        }
        <span
          class="t-label-xs normal-case tracking-[0.08em] text-[color:rgb(255_255_255/0.85)]"
          {...editable({ collection: 'site', fields: 'tagline', mode: 'popover' })}
        >
          {site.tagline}
        </span>
      </div>
    </div>

    <!-- Comment #7 removed the Products and Company columns; their grid space is
         kept so the remaining columns do not reflow, and the social row now sits
         in it — centred between the logo and the address, where the client marked
         it. The container is rendered even when the icons are not (Home), or the
         two columns beside it would close up. -->
    <div class="flex items-center justify-center md:col-span-2">
      {showSocials && <SocialLinks socials={site.socials} tone="on-dark" />}
    </div>

    <div class="flex flex-col gap-4">
      {/* The colour is spelled out because the base stylesheet gives every
          heading `--text-primary`, which is dark ink — inheriting the footer's
          white does not survive that. */}
      {site.footer_contact_heading && (
        <h2
          class="t-label-xs text-[color:var(--text-inverse)]"
          {...editable({ collection: 'site', fields: 'footer_contact_heading', mode: 'popover' })}
        >
          {site.footer_contact_heading}
        </h2>
      )}
      <address class="flex flex-col gap-3 t-body-sm not-italic">
        <span
          class="flex flex-col"
          {...editable({ collection: 'site', fields: 'address', mode: 'popover' })}
        >
          {site.address_lines.map((line) => <span>{line}</span>)}
        </span>
        {/* Labelled, as asked. The label is outside the link so only the number
            and the address are clickable — "Phone:" is not a phone number. */}
        <span class="flex flex-wrap items-baseline gap-x-1.5">
          <span class="shrink-0 opacity-80">Phone:</span>
          <a
            href={site.phone_href}
            class={link}
            {...editable({ collection: 'site', fields: ['phone', 'phone_href'], mode: 'popover' })}
          >
            {site.phone}
          </a>
        </span>
        <span class="flex flex-wrap items-baseline gap-x-1.5">
          <span class="shrink-0 opacity-80">Email:</span>
          <a
            href={`mailto:${site.email}`}
            class={link}
            {...editable({ collection: 'site', fields: 'email', mode: 'popover' })}
          >
            {site.email}
          </a>
        </span>
      </address>
    </div>
  </div>

  <div class="relative bg-footer-deep">
    <div class="rail flex flex-wrap items-center justify-between gap-2 py-5 t-label-sm">
      <p {...editable({ collection: 'site', fields: 'footer_rights', mode: 'popover' })}>
        © {new Date().getFullYear()} {site.company_name}. {site.footer_rights}
      </p>
      {site.footer_note && (
        <p {...editable({ collection: 'site', fields: 'footer_note', mode: 'popover' })}>
          {site.footer_note}
        </p>
      )}
    </div>
  </div>
</footer>

<!--
  Floating WhatsApp button.

  Deliberately a sibling of <footer> rather than a child: the footer is
  `relative overflow-hidden`, and a fixed element inside an ancestor like that is
  at the mercy of how the browser resolves its containing block. Outside, it is
  simply fixed to the viewport.

  It fades in when the footer comes into view and fades out again above it, which
  is what "on the footer only" means in practice — a button that follows the
  reader down the whole page is a different, more insistent thing.
-->
{
  site.phone && (
    <a
      href={whatsapp}
      rel="noopener noreferrer"
      target="_blank"
      class="whatsapp-fab fixed right-5 bottom-5 z-40 grid size-14 place-items-center rounded-full
             text-white shadow-[0_10px_28px_rgb(4_10_16/0.28)] md:right-8 md:bottom-8"
      style="background:#25D366"
      aria-label={`Message us on WhatsApp — ${site.phone}`}
      data-whatsapp-fab
      hidden
    >
      <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
        <path d={socialPaths.whatsapp} fill="currentColor" />
      </svg>
    </a>
  )
}

<style>
  /* Hidden until the footer is reached; `hidden` in the markup is removed by the
     script, so without JavaScript it never appears at all rather than sitting
     over the page permanently. */
  .whatsapp-fab {
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    transition:
      opacity 220ms var(--ease-standard),
      transform 220ms var(--ease-standard);
  }
  .whatsapp-fab.is-visible {
    opacity: 1;
    transform: none;
  }
  .whatsapp-fab:hover {
    filter: brightness(1.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      transition: none;
    }
  }
</style>

<script>
  const fab = document.querySelector<HTMLElement>('[data-whatsapp-fab]');
  const footer = document.querySelector('footer');

  if (fab && footer) {
    fab.hidden = false;
    const observer = new IntersectionObserver(
      ([entry]) => fab.classList.toggle('is-visible', entry.isIntersecting),
      // A sliver of the footer is enough; waiting for more means the button
      // arrives after the reader has already passed the contact details.
      { threshold: 0.01 },
    );
    observer.observe(footer);
  }
</script>
