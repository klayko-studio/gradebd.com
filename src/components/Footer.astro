---
import Doodles from './Doodles.astro';
import SocialLinks from './SocialLinks.astro';
import { socialPaths } from '../lib/social-icons';
import type { Category, Site } from '../lib/schema';

interface Props {
  site: Site;
  categories: Category[];
  /**
   * The client wants social icons everywhere except Home ("Social Media wont be
   * available on Home Page only"), so the layout passes this in per page.
   */
  showSocials?: boolean;
}
const { site, categories, showSocials = true } = Astro.props;

const link = 'transition-opacity hover:opacity-70';
---

<footer class="relative overflow-hidden bg-footer text-[color:var(--text-inverse)]">
  <Doodles color="#ffffff" opacity={0.09} />

  <div class="rail relative grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1.2fr]">
    <div class="flex flex-col gap-5">
      <!-- The client's reversed lockup, which carries "Stationary" as artwork — this
           is comment #22 delivered properly, replacing the version we set in type
           while waiting for it. The tagline is not part of the mark, so it stays as
           a line of type beneath. -->
      <div class="flex flex-col gap-2">
        <img
          src="/images/brand/grade-logo-white-stationary.png"
          alt={site.company_name}
          width="196"
          height="61"
          class="block h-[52px] w-auto"
        />
        <span class="t-label-xs normal-case tracking-[0.08em] text-[color:rgb(255_255_255/0.85)]">
          {site.tagline}
        </span>
      </div>
      <p class="t-body-sm max-w-[34ch]">
        Supplying pens, exercise books and office stationery to businesses across Bangladesh since {
          site.founded_year
        }.
      </p>
      {showSocials && <SocialLinks socials={site.socials} tone="on-dark" />}
    </div>

    <!-- Comment #7: the Products and Company columns are gone, but their grid space
         is deliberately kept so the remaining columns do not reflow. -->
    <div aria-hidden="true" class="hidden lg:block"></div>
    <div aria-hidden="true" class="hidden lg:block"></div>

    <div class="flex flex-col gap-4">
      <h2 class="t-label-xs">Get in touch</h2>
      <address class="flex flex-col gap-3 t-body-sm not-italic">
        {site.address_lines.map((line) => <span>{line}</span>)}
        <a href={site.phone_href} class={link}>{site.phone}</a>
        <a href={`mailto:${site.email}`} class={link}>{site.email}</a>
        <a href={`https://wa.me/${site.phone.replace(/[^0-9]/g, '')}`} class={`flex items-center gap-2 ${link}`} rel="noopener noreferrer" target="_blank">
          <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0">
            <path d={socialPaths.whatsapp} fill="currentColor" />
          </svg>
          WhatsApp {site.phone}
        </a>
        <span class="text-[color:rgb(255_255_255/0.8)]">{site.opening_hours}</span>
      </address>
    </div>
  </div>

  <div class="relative bg-footer-deep">
    <div class="rail flex flex-wrap items-center justify-between gap-2 py-5 t-label-sm">
      <p>© {new Date().getFullYear()} {site.company_name}. All rights reserved.</p>
      <p>B2B supplier · Dhanmondi, Dhaka</p>
    </div>
  </div>
</footer>
