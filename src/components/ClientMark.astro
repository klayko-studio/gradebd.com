---
/** Placeholder geometric marks so the logo wall reads as distinct brands. */
interface Props { mark: string }
const { mark } = Astro.props;
const ink = 'var(--text-muted)';
---
<span class="block h-7 w-7 shrink-0" aria-hidden="true">
  <svg viewBox="0 0 28 28" width="28" height="28" fill="none">
    {mark === 'ring' && <circle cx="14" cy="14" r="11" stroke={ink} stroke-width="3" />}
    {mark === 'disc' && <circle cx="14" cy="14" r="11" fill={ink} />}
    {mark === 'diamond' && <rect x="14" y="1.5" width="17" height="17" rx="1" transform="rotate(45 14 1.5)" fill={ink} />}
    {mark === 'square' && <rect x="3" y="3" width="22" height="22" rx="4" stroke={ink} stroke-width="3" />}
    {mark === 'triangle' && <path d="M14 3l11 20H3L14 3z" fill={ink} />}
    {mark === 'bars' && (
      <g fill={ink}>
        <rect x="2" y="6" width="24" height="4" rx="1" />
        <rect x="2" y="13" width="18" height="4" rx="1" />
        <rect x="2" y="20" width="12" height="4" rx="1" />
      </g>
    )}
    {mark === 'dots' && (
      <g fill={ink}>
        <circle cx="9" cy="9" r="4" /><circle cx="20" cy="9" r="4" />
        <circle cx="9" cy="20" r="4" /><circle cx="20" cy="20" r="4" />
      </g>
    )}
    {mark === 'chevron' && (
      <path d="M4 18l10-9 10 9" stroke={ink} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    )}
  </svg>
</span>
