---
/**
 * Full-screen media viewer — markup only; `src/scripts/lightbox.ts` drives it.
 *
 * One dialog per page rather than one per picture: the images are large, and
 * thirty copies of the same markup to show one at a time is thirty times the DOM
 * for no gain. Whoever opens it hands it the list.
 *
 * It shows videos as well as stills. A slide carrying `type: 'video'` swaps the
 * <img> for the <video> below and takes the zoom controls off the bar — a video
 * element has its own controls and scaling one by transform would move its
 * native UI off screen with it.
 */
interface Props {
  id: string;
  label: string;
  /** Off for product photos, which carry no caption of their own. */
  captions?: boolean;
}
const { id, label, captions = true } = Astro.props;

const roundButton =
  'grid place-items-center rounded-full bg-[color:rgb(255_255_255/0.16)] text-white ' +
  'transition-colors hover:bg-[color:rgb(255_255_255/0.3)] ' +
  'disabled:pointer-events-none disabled:opacity-35';
---

<dialog {id} class="lightbox border-0 bg-transparent p-0" aria-label={label}>
  <div
    class="relative flex h-full w-full flex-col items-center justify-center gap-4 p-4 md:p-8"
    data-lightbox-backdrop
  >
    <!-- The close and zoom controls sit above the picture on every size, so they
         never end up over the image on a narrow screen.

         A three-column grid rather than `justify-between`: the counter and the
         zoom group are each hidden in some states (a single image, a video), and
         a grid keeps the remaining controls where they were instead of letting
         them slide across the bar.

         Each one names its own column, which is the part that actually makes
         that true. A `display: none` item is removed from the grid rather than
         leaving its cell empty, so with auto-placement the close button simply
         moved up into the gap — on a video it ended up in the middle of the
         bar. -->
    <div
      class="grid w-full max-w-[1200px] shrink-0 grid-cols-[1fr_auto_1fr] items-center gap-3"
    >
      {/*
        The counter, and a word for what the slide actually is.

        "2 / 2" on its own does not tell a reader that the thing they just
        stepped onto is a film rather than another photograph — which is exactly
        how this went wrong: a video whose first frame resembles the photograph
        before it is indistinguishable from not having advanced at all.
      */}
      <p class="col-start-1 flex items-center gap-2 t-label-sm text-[color:rgb(255_255_255/0.9)]">
        <span data-lightbox-counter>
          <span data-lightbox-index>1</span> / <span data-lightbox-total>1</span>
        </span>
        <span
          class="rounded-full bg-[color:rgb(255_255_255/0.18)] px-2 py-0.5 t-label-xs"
          data-lightbox-kind
          hidden
        >
          Video
        </span>
      </p>

      <!-- Zoom, on the client's "add one click to Zoom In & one click to Zoom
           Out". The wheel and the pinch were already there; what was missing was
           a control you can see, which is also the only way in on a machine with
           no wheel and no touch screen. -->
      <div
        class="col-start-2 flex items-center gap-1 rounded-full bg-[color:rgb(255_255_255/0.12)] p-1"
        data-lightbox-zoom-controls
      >
        <button type="button" class={`${roundButton} size-9`} data-lightbox-zoom-out aria-label="Zoom out">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
            <path d="M8 11h6M20 20l-3.8-3.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>

        <!-- A button, not a label: it reads as the current zoom and pressing it
             puts the picture back to fit, which is the one action a reader who
             has zoomed too far actually wants. -->
        <button
          type="button"
          class="min-w-[4.5rem] rounded-full px-2 py-1.5 t-label-sm text-[color:rgb(255_255_255/0.9)]
                 transition-colors hover:bg-[color:rgb(255_255_255/0.18)]
                 disabled:pointer-events-none disabled:opacity-60"
          data-lightbox-zoom-reset
          aria-label="Reset zoom to fit"
        >
          <span data-lightbox-zoom-level>100%</span>
        </button>

        <button type="button" class={`${roundButton} size-9`} data-lightbox-zoom-in aria-label="Zoom in">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
            <path
              d="M11 8v6M8 11h6M20 20l-3.8-3.8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <button
        type="button"
        class={`${roundButton} col-start-3 size-11 justify-self-end`}
        data-lightbox-close
        aria-label="Close viewer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M18 6 6 18M6 6l12 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <div class="flex min-h-0 w-full max-w-[1200px] flex-1 items-center gap-3 md:gap-5">
      <button
        type="button"
        class={`${roundButton} size-11 shrink-0 md:size-14`}
        data-lightbox-prev
        aria-label="Previous image"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M15 18 9 12l6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      {/*
        The picture sits in a stage of its own so a zoomed image is clipped to
        the frame instead of spilling over the prev/next controls beside it.
        The stage keeps the height cap the image used to carry, so the layout is
        unchanged at rest.
      */}
      <div
        class="relative flex min-h-0 w-full flex-1 items-center justify-center overflow-hidden"
        style="max-height:calc(100dvh - 12rem)"
        data-lightbox-stage
      >
        {/*
          `draggable="false"` is not decoration — it is what makes panning work
          at all with a mouse. See the note in the stylesheet below.
        */}
        <img
          src=""
          alt=""
          draggable="false"
          class="h-full w-full rounded-sharp object-contain"
          data-lightbox-image
        />

        {/*
          The video half of the stage. `playsinline` so a phone plays it in the
          frame rather than handing it to the OS player, `preload="metadata"` so
          the poster and duration arrive without pulling the whole file down for
          a viewer who never presses play.
        */}
        <video
          class="hidden h-full w-full rounded-sharp object-contain"
          data-lightbox-video
          controls
          playsinline
          preload="metadata"></video>

        {/*
          The play control.

          A <video controls> has a play button of its own, and it was not
          enough: it is a thin native bar at the foot of the element, easy to
          miss against a light frame, and with nothing else on screen saying
          "video" the first thing a reader does is click the picture — which in
          Chrome starts playback, so the film appears to begin for no reason.

          This is deliberately NOT a full-bleed overlay. Covering the stage
          would put a transparent button over the native control bar and take
          the timeline away. The scrim ignores the pointer and only the disc is
          clickable, so everything underneath still works.
        */}
        <button
          type="button"
          class="lightbox-play absolute inset-0 place-items-center"
          data-lightbox-play
          aria-label="Play video"
        >
          <span
            class="grid size-20 place-items-center rounded-full bg-[color:rgb(255_255_255/0.94)]
                   text-[color:var(--text-primary)] shadow-[0_8px_28px_rgb(4_10_16/0.4)]
                   transition-transform duration-200 ease-[var(--ease-standard)]"
          >
            <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5.2v13.6a.6.6 0 0 0 .91.51l11.2-6.8a.6.6 0 0 0 0-1.02L8.91 4.69A.6.6 0 0 0 8 5.2Z" />
            </svg>
          </span>
        </button>

        {/*
          The drag hint. The panning has always worked, but nothing on screen
          said so — the client zoomed in and asked for a way to reach the rest of
          the picture. It only appears once there is something to drag to.
        */}
        <p
          class="pointer-events-none absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full
                 bg-[color:rgb(6_20_28/0.66)] px-3 py-1.5 t-label-xs whitespace-nowrap
                 text-[color:rgb(255_255_255/0.92)] opacity-0 transition-opacity duration-200"
          data-lightbox-hint
          aria-hidden="true"
        >
          Drag to move around
        </p>
      </div>

      <button
        type="button"
        class={`${roundButton} size-11 shrink-0 md:size-14`}
        data-lightbox-next
        aria-label="Next image"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m9 18 6-6-6-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <!-- Not a <figcaption>: there is no <figure> here, and the caption belongs to
         whichever picture is showing rather than to fixed markup. -->
    {
      captions && (
        <p class="flex w-full max-w-[1200px] shrink-0 flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center">
          <span class="t-label-md text-white" data-lightbox-caption />
          <span class="t-label-xs text-[color:rgb(255_255_255/0.7)]" data-lightbox-tag />
        </p>
      )
    }
  </div>
</dialog>

<style>
  /* Fills the viewport rather than sitting in the middle of it: this is a viewer,
     not a panel. `margin: 0` because the reset zeroes the auto-centring a dialog
     normally does, and here we want the corners anyway. */
  .lightbox {
    margin: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
  }
  .lightbox::backdrop {
    background: rgb(6 20 28 / 0.92);
  }

  /**
   * Zoom state, driven by the script.
   *
   * `touch-action: none` on a still, and that is load-bearing: a pinch only
   * reaches the script if the browser is not handling it first. Scoped to the
   * picture, so the rest of the viewer still scrolls and the page behind the
   * dialog is untouched.
   */
  /**
   * `touch-action: none` handles the finger. This handles the mouse, and it is
   * the whole reason dragging a zoomed picture works.
   *
   * An <img> is natively draggable. Press one with a mouse and move, and the
   * browser starts its own drag-and-drop — the ghost image — which fires
   * `pointercancel` and takes the pointer stream away from the script. The pan
   * therefore died on the first pixel of movement, on every browser, for every
   * mouse user; the client reported it as "after zooming, user should be able
   * to move cursor to view different part of the image", which is what that
   * looks like from the outside.
   *
   * It survived a test because synthetic pointer events do not start a native
   * drag. Only a real mouse does.
   *
   * Three guards because the mechanisms differ: the `draggable="false"`
   * attribute in the markup is the standard one, `-webkit-user-drag` is what
   * WebKit reads, and the `dragstart` handler in the script is the backstop
   * that does not depend on either being honoured.
   */
  [data-lightbox-stage] {
    cursor: zoom-in;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  [data-lightbox-image] {
    -webkit-user-drag: none;
  }
  [data-lightbox-stage].is-zoomed {
    cursor: grab;
  }
  [data-lightbox-stage].is-panning {
    cursor: grabbing;
  }
  /* The hint is a teaching aid, not chrome. It shows when there is first
     something to drag to and retires itself — on a phone it sits over a third
     of the picture, which is a poor trade for a sentence nobody needs twice. */
  [data-lightbox-stage].is-zoomed [data-lightbox-hint] {
    opacity: 1;
  }
  [data-lightbox-stage].is-panning [data-lightbox-hint],
  [data-lightbox-stage].hint-done [data-lightbox-hint] {
    opacity: 0;
  }
  /* A video owns its own gestures — scrubbing the timeline is a drag, and
     suppressing touch here would make the native controls unusable on a phone. */
  [data-lightbox-stage].is-video {
    cursor: default;
    touch-action: auto;
  }

  /**
   * The play disc, shown only on a paused video.
   *
   * The element spans the stage so the disc can be centred over the frame, but
   * `pointer-events: none` on the box and `auto` on the disc means the only
   * clickable part is the disc itself. Without that split it would sit over the
   * native control bar and swallow the timeline — the button would work once
   * and then make the player unusable.
   */
  .lightbox-play {
    display: none;
    pointer-events: none;
    background: rgb(6 20 28 / 0.22);
  }
  .lightbox-play.is-on {
    display: grid;
  }
  .lightbox-play > span {
    pointer-events: auto;
  }
  .lightbox-play:hover > span {
    transform: scale(1.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-play > span {
      transition: none;
    }
    .lightbox-play:hover > span {
      transform: none;
    }
  }
  [data-lightbox-image] {
    transform-origin: center center;
    will-change: transform;
  }
  .lightbox[open] {
    animation: lightbox-in 160ms var(--ease-standard);
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] {
      animation: none;
    }
    [data-lightbox-hint] {
      transition: none;
    }
  }
</style>
