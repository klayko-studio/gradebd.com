---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import SectionHead from '../components/SectionHead.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ProductCard from '../components/ProductCard.astro';
import BrandBand from '../components/BrandBand.astro';
import Button from '../components/Button.astro';
import { getHome, getCategories, getClients, getSite } from '../lib/cms';

const [home, categories, clients, site] = await Promise.all([
  getHome(),
  getCategories(),
  getClients(),
  getSite(),
]);

/**
 * Sub-brands, counted straight off the catalogue so the band cannot drift from the
 * data. The blurb says which desk each line is for — that is the distinction the
 * client's naming makes, and it is not obvious from the name alone.
 */
const BLURBS: Record<string, string> = {
  Champ: 'School kit — pencils, colour, erasers, boxes and boards.',
  Neo: 'Everyday utility — pencils, sharpeners, clipboards, dusters.',
  Xtreme: 'Office hardware — staplers, punches, staples.',
  Dox: 'Filing — covers, bags, folders, files and carriers.',
};
const subBrands = Object.values(
  categories.reduce<Record<string, { name: string; count: number; accent: string; categorySlug: string; blurb: string }>>(
    (acc, category) => {
      for (const item of category.items) {
        if (!item.sub_brand) continue;
        acc[item.sub_brand] ??= {
          name: item.sub_brand,
          count: 0,
          accent: category.accent,
          categorySlug: category.slug,
          blurb: BLURBS[item.sub_brand] ?? '',
        };
        acc[item.sub_brand].count += 1;
      }
      return acc;
    },
    {},
  ),
).sort((a, b) => b.count - a.count);
---

<Base seo={home.seo} active="home">
  <HeroSlider slides={home.slides} />

  <!-- credibility strip -->
  <section class="border-b border-line-subtle">
    <div class="rail grid grid-cols-2 gap-y-8 py-8 md:grid-cols-4" data-reveal-group>
      {
        home.stats.map((stat, i) => (
          <div
            data-reveal
            class:list={['flex flex-col gap-1 md:px-8', i > 0 && 'md:border-l md:border-line-subtle', i === 0 && 'md:pl-0']}
          >
            <p class="t-heading-sm tabular-nums" data-count={stat.value}>{stat.value}</p>
            <p class="t-body-sm text-[color:var(--text-muted)]">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- who we are -->
  <section class="section">
    <div class="rail grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="flex flex-col gap-5">
        <Eyebrow data-reveal>{home.who_we_are.eyebrow}</Eyebrow>
        <h2 class="t-heading-xl max-w-[24ch]" data-reveal>{home.who_we_are.heading}</h2>
        {home.who_we_are.body.map((para) => <p class="t-body-md max-w-[58ch]" data-reveal>{para}</p>)}
        <div data-reveal class="mt-2">
          <Button href="/about/" variant="secondary">{home.who_we_are.cta_label}</Button>
        </div>
      </div>
      <div data-reveal class="overflow-hidden rounded-sharp border border-line-subtle">
        <img
          src={home.who_we_are.image.src}
          alt={home.who_we_are.image.alt}
          width={home.who_we_are.image.width}
          height={home.who_we_are.image.height}
          loading="lazy"
          class="aspect-[5/4] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- the five ranges -->
  <section class="section pt-0">
    <div class="rail">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead eyebrow={home.categories_intro.eyebrow} heading={home.categories_intro.heading} />
        <a
          href={`/${categories[0].slug}/`}
          data-reveal
          class="group flex items-center gap-2 t-button text-[color:var(--text-brand-strong)]"
        >
          See all
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-1">
            <path d="M5 12h13M12.5 6.5L18 12l-5.5 5.5" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div
        class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"
        data-reveal-group
      >
        {
          categories.map((c) => (
            <ProductCard
              name={c.name}
              meta={c.meta}
              image={c.image}
              accent={c.accent}
              action="View range"
              href={`/${c.slug}/`}
              imageHeight="short"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- The client's own sub-brands. Every SKU is named "Grade <sub-brand> …", so this
       is how the range is actually organised — and it gives the packaging-led brand
       direction somewhere to live beyond colour. -->
  {
    subBrands.length > 0 && (
      <section class="section pt-0">
        <div class="rail">
          <SectionHead
            eyebrow="Our sub-brands"
            heading="Four lines, each built for a different desk."
          />
          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
            {subBrands.map((brand) => (
              <a
                href={`/${brand.categorySlug}/`}
                class="group flex flex-col gap-3 rounded-sharp border border-line-subtle bg-surface p-6
                       transition-[border-color,box-shadow] duration-200 ease-[var(--ease-standard)]
                       hover:border-line-brand hover:shadow-[var(--shadow-ambient)]"
              >
                <span
                  aria-hidden="true"
                  class="h-[4px] w-8 rounded-full transition-[width] duration-300 ease-[var(--ease-standard)] group-hover:w-14"
                  style={`background:${brand.accent}`}
                />
                <h3 class="t-heading-md">{brand.name}</h3>
                <p class="t-body-sm text-[color:var(--text-secondary)]">{brand.blurb}</p>
                <p class="mt-1 t-label-sm text-[color:var(--text-muted)]">
                  {brand.count} {brand.count === 1 ? 'product' : 'products'}
                </p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- why grade -->
  <section class="section bg-subtle">
    <div class="rail">
      <SectionHead eyebrow={home.pillars_intro.eyebrow} heading={home.pillars_intro.heading} />
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5" data-reveal-group>
        {
          home.pillars.map((pillar, i) => (
            <div data-reveal class="flex flex-col gap-3 border-t-2 border-line-brand pt-5">
              <p class="t-label-xs text-[color:var(--text-brand-strong)]">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="t-heading-md">{pillar.title}</h3>
              {pillar.body && <p class="t-body-sm">{pillar.body}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- corporate clients -->
  <section class="section bg-inverse text-[color:var(--text-inverse)]" id="clients">
    <div class="rail">
      <SectionHead
        eyebrow={home.clients_intro.eyebrow}
        heading={home.clients_intro.heading}
        tone="dark"
      />

      <p class="mt-3 max-w-[70ch] t-body-sm text-[color:var(--text-inverse-muted)]">
        Every mark here is its owner’s registered trademark. Six are still placeholders while we
        wait on the artwork, and Grade needs written permission from all fifteen before this
        goes live.
      </p>

      <!-- A slider rather than a wall: fifteen companies will not sit on one row, and
           the client asked for arrows. Native scroll-snap does the work, so it stays
           usable by touch and keyboard with the arrows as an enhancement. -->
      <div
        class="client-track mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2
               [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        data-client-track
      >
        {
          clients.map((client) => (
            <div
              class="flex w-[calc((100%-4*1.25rem)/5)] min-w-[180px] shrink-0 snap-start flex-col
                     items-center gap-3 text-center"
            >
              {client.logo ? (
                <img
                  src={client.logo}
                  alt={client.name}
                  width="300"
                  height="110"
                  loading="lazy"
                  class="h-16 w-full object-contain [filter:brightness(0)_invert(1)] opacity-90"
                />
              ) : (
                <span
                  class="flex h-16 w-full items-center justify-center rounded-sharp border border-dashed
                         border-[color:rgb(255_255_255/0.34)]"
                  title="Placeholder — logo pending"
                />
              )}
              <span class="t-label-xs text-[color:var(--text-inverse-muted)]">{client.name}</span>
            </div>
          ))
        }
      </div>

      <div class="mt-6 flex items-center justify-end gap-2.5">
        <button
          type="button"
          class="grid size-11 place-items-center rounded-full border border-[color:rgb(255_255_255/0.4)]
                 text-[color:var(--text-inverse)] transition-colors hover:bg-[color:rgb(255_255_255/0.14)]"
          data-client-prev
          aria-label="Previous clients"
        >
          <svg width="8" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18 9 12l6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          type="button"
          class="grid size-11 place-items-center rounded-full border border-[color:rgb(255_255_255/0.4)]
                 text-[color:var(--text-inverse)] transition-colors hover:bg-[color:rgb(255_255_255/0.14)]"
          data-client-next
          aria-label="More clients"
        >
          <svg width="8" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Client Feedback is hidden on the client's instruction (comment #17: "Hide this
       whole Client Feedback section for now. Might need it later."). The data and the
       markup are intact in git history; nothing here is deleted, just not rendered. -->

  <BrandBand
    eyebrow="Empowering your potential"
    heading="Stocked for the whole school year."
    body="From the first pencil box in January to the last file of the audit season — quoted by the carton, delivered on the date agreed."
    socials={site.socials}
  />
</Base>

<style>
  /* The track is a scroller, so a logo at the edge is always half-cut. Fading the
     last stretch makes that read as "there is more" rather than as a mistake. */
  .client-track {
    /* Two values, and the only rule between them is that the space is comfortably
       bigger than the fade — otherwise the first and last logos sit under it, which
       is what the client saw. They were 40px of padding against a 2% fade: at 1296px
       that is 26px, leaving 14px of clearance that read as a logo being dimmed.
       Both scale on the same vw with doubled bounds, so the space is exactly twice
       the fade at every width — 40/20 on a phone, 64/32 on a wide desktop — and 64px
       of inset never lands on a 375px screen. */
    --edge-fade: clamp(1.25rem, 2vw, 2rem);
    --edge-space: clamp(2.5rem, 4vw, 4rem);

    padding-inline: var(--edge-space);
    scroll-padding-inline: var(--edge-space);

    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 var(--edge-fade),
      #000 calc(100% - var(--edge-fade)),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 var(--edge-fade),
      #000 calc(100% - var(--edge-fade)),
      transparent 100%
    );
    scroll-behavior: smooth;
  }
</style>


<script>
  // Client slider: scroll by a viewport-width of the track, so the arrows move a
  // whole "page" of logos rather than an arbitrary pixel count.
  const track = document.querySelector<HTMLElement>('[data-client-track]');
  if (track) {
    const page = () => Math.max(track.clientWidth * 0.8, 240);
    document
      .querySelector('[data-client-prev]')
      ?.addEventListener('click', () => track.scrollBy({ left: -page(), behavior: 'smooth' }));
    document
      .querySelector('[data-client-next]')
      ?.addEventListener('click', () => track.scrollBy({ left: page(), behavior: 'smooth' }));
  }
</script>

