---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import SectionHead from '../components/SectionHead.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ProductCard from '../components/ProductCard.astro';
import BrandBand from '../components/BrandBand.astro';
import Button from '../components/Button.astro';
import { getHome, getCategories, getClients, getSite, editable } from '../lib/cms';

const [home, categories, clients, site] = await Promise.all([
  getHome(),
  getCategories(),
  getClients(),
  getSite(),
]);

---

<Base seo={home.seo} active="home">
  <HeroSlider slides={home.slides} edit={editable({ collection: 'home', fields: 'slides', mode: 'drawer' })} />

  <!-- The credibility strip — "Since 2019", "300+ work orders" — is not
       rendered, on the client's instruction. The `stats` data is still in the
       CMS and this markup is in git history, so putting it back is a revert
       rather than a rebuild. -->

  <!-- who we are -->
  <section class="section">
    <div class="rail grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div
        class="flex flex-col gap-5"
        {...editable({
          collection: 'home',
          fields: ['who_we_are_eyebrow', 'who_we_are_heading', 'who_we_are_body', 'who_we_are_cta_label'],
          mode: 'drawer',
        })}
      >
        <Eyebrow data-reveal>{home.who_we_are.eyebrow}</Eyebrow>
        <h2 class="t-heading-xl max-w-[24ch]" data-reveal>{home.who_we_are.heading}</h2>
        {home.who_we_are.body.map((para) => <p class="t-body-md max-w-[58ch]" data-reveal>{para}</p>)}
        <div data-reveal class="mt-2">
          <Button href="/about/" variant="secondary">{home.who_we_are.cta_label}</Button>
        </div>
      </div>
      <div data-reveal class="overflow-hidden rounded-sharp border border-line-subtle">
        <img
          src={home.who_we_are.image.src}
          alt={home.who_we_are.image.alt}
          width={home.who_we_are.image.width}
          height={home.who_we_are.image.height}
          loading="lazy"
          class="aspect-[5/4] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- the five ranges -->
  <section class="section pt-0">
    <div class="rail">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          eyebrow={home.categories_intro.eyebrow}
          heading={home.categories_intro.heading}
          edit={editable({
            collection: 'home',
            fields: ['categories_intro_eyebrow', 'categories_intro_heading'],
          })}
        />
        <a
          href={`/${categories[0].slug}/`}
          data-reveal
          class="group flex items-center gap-2 t-button text-[color:var(--text-brand-strong)]"
        >
          See all
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-1">
            <path d="M5 12h13M12.5 6.5L18 12l-5.5 5.5" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <!-- No sub-category line on these cards: the range name is the whole label.
           `meta` is still in the CMS and still used on the item cards. -->
      <div
        class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"
        data-reveal-group
      >
        {
          categories.map((c) => (
            <ProductCard
              name={c.name}
              image={c.image}
              accent={c.accent}
              action="View range"
              href={`/${c.slug}/`}
              imageHeight="short"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- The sub-brand band (Champ · Neo · Xtreme · Dox) is not rendered, on the
       client's instruction. The ranges are still browsable by sub-brand from the
       filter row on each category page. -->

  <!-- "Our Values" is not rendered here, on the client's instruction. It still
       has its own section on the About page, which is where the client's own copy
       for it lives. -->

  <!-- corporate clients -->
  <section class="section bg-inverse text-[color:var(--text-inverse)]" id="clients">
    <div class="rail">
      <SectionHead
        eyebrow={home.clients_intro.eyebrow}
        heading={home.clients_intro.heading}
        tone="dark"
        edit={editable({
          collection: 'home',
          fields: ['clients_intro_eyebrow', 'clients_intro_heading'],
        })}
      />

      <!-- A slider rather than a wall: fifteen companies will not sit on one row, and
           the client asked for arrows. Native scroll-snap does the work, so it stays
           usable by touch and keyboard with the arrows as an enhancement. -->
      <div
        class="client-track mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2
               [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        data-client-track
      >
        {
          clients.map((client) => (
            <div
              class="flex w-[calc((100%-4*1.25rem)/5)] min-w-[180px] shrink-0 snap-start flex-col
                     items-center gap-3 text-center"
            >
              {client.logo ? (
                <img
                  src={client.logo}
                  alt={client.name}
                  width="300"
                  height="110"
                  loading="lazy"
                  class="h-16 w-full object-contain [filter:brightness(0)_invert(1)] opacity-90"
                />
              ) : (
                <span
                  class="flex h-16 w-full items-center justify-center rounded-sharp border border-dashed
                         border-[color:rgb(255_255_255/0.34)]"
                  title="Placeholder — logo pending"
                />
              )}
              <span class="t-label-xs text-[color:var(--text-inverse-muted)]">{client.name}</span>
            </div>
          ))
        }
      </div>

      <div class="mt-6 flex items-center justify-end gap-2.5">
        <button
          type="button"
          class="grid size-11 place-items-center rounded-full border border-[color:rgb(255_255_255/0.4)]
                 text-[color:var(--text-inverse)] transition-colors hover:bg-[color:rgb(255_255_255/0.14)]"
          data-client-prev
          aria-label="Previous clients"
        >
          <svg width="8" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18 9 12l6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          type="button"
          class="grid size-11 place-items-center rounded-full border border-[color:rgb(255_255_255/0.4)]
                 text-[color:var(--text-inverse)] transition-colors hover:bg-[color:rgb(255_255_255/0.14)]"
          data-client-next
          aria-label="More clients"
        >
          <svg width="8" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Client Feedback is hidden on the client's instruction (comment #17: "Hide this
       whole Client Feedback section for now. Might need it later."). The data and the
       markup are intact in git history; nothing here is deleted, just not rendered. -->

  <!-- The section is the social row now, so the copy about stocking a school year
       is gone with it; a lead-in about pencil boxes under a "Contacts" heading read
       as two unrelated things stacked. -->
  <BrandBand heading="Our Social Media Contacts" socials={site.socials} />
</Base>

<style>
  /* The track is a scroller, so a logo at the edge is always half-cut. Fading the
     last stretch makes that read as "there is more" rather than as a mistake. */
  .client-track {
    /* Two values, and the only rule between them is that the space is comfortably
       bigger than the fade — otherwise the first and last logos sit under it, which
       is what the client saw. They were 40px of padding against a 2% fade: at 1296px
       that is 26px, leaving 14px of clearance that read as a logo being dimmed.
       Both scale on the same vw with doubled bounds, so the space is exactly twice
       the fade at every width — 40/20 on a phone, 64/32 on a wide desktop — and 64px
       of inset never lands on a 375px screen. */
    --edge-fade: clamp(1.25rem, 2vw, 2rem);
    --edge-space: clamp(2.5rem, 4vw, 4rem);

    padding-inline: var(--edge-space);
    scroll-padding-inline: var(--edge-space);

    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 var(--edge-fade),
      #000 calc(100% - var(--edge-fade)),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 var(--edge-fade),
      #000 calc(100% - var(--edge-fade)),
      transparent 100%
    );
    scroll-behavior: smooth;
  }
</style>


<script>
  // Client slider: scroll by a viewport-width of the track, so the arrows move a
  // whole "page" of logos rather than an arbitrary pixel count.
  const track = document.querySelector<HTMLElement>('[data-client-track]');
  if (track) {
    const page = () => Math.max(track.clientWidth * 0.8, 240);

    const step = (direction: 1 | -1) => {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      // Wrap rather than sitting at the end: fifteen logos on a loop should keep
      // going round, not stop with the last one half-cut against the edge.
      if (direction === 1 && atEnd) track.scrollTo({ left: 0, behavior: 'smooth' });
      else if (direction === -1 && track.scrollLeft <= 4) {
        track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
      } else track.scrollBy({ left: direction * page(), behavior: 'smooth' });
    };

    /**
     * Auto-advance.
     *
     * Paused while the pointer is over the row or the keyboard is inside it —
     * a strip that moves out from under someone reading a logo, or tabbing
     * through the links, is worse than one that never moves. Skipped entirely
     * under prefers-reduced-motion, and while the tab is in the background,
     * where the timer would otherwise queue up jumps to replay on return.
     */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number | undefined;

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (reduced.matches || document.hidden) return;
      timer = window.setInterval(() => step(1), 3500);
    };

    // An arrow press restarts the clock, so a deliberate move is not immediately
    // followed by an automatic one.
    document.querySelector('[data-client-prev]')?.addEventListener('click', () => {
      step(-1);
      start();
    });
    document.querySelector('[data-client-next]')?.addEventListener('click', () => {
      step(1);
      start();
    });

    track.addEventListener('pointerenter', stop);
    track.addEventListener('pointerleave', start);
    track.addEventListener('focusin', stop);
    track.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduced.addEventListener('change', start);

    start();
  }
</script>

