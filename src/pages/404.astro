---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { getCategories, getSite, getNotFound, editable } from '../lib/cms';

const [categories, site, notFound] = await Promise.all([
  getCategories(),
  getSite(),
  getNotFound(),
]);
---

<Base seo={{ ...notFound.seo, noindex: true }}>
  <section class="section">
    <div class="rail flex max-w-[70ch] flex-col gap-6">
      {notFound.eyebrow && (
        <p
          class="t-label-xs text-[color:var(--text-brand-strong)]"
          {...editable({ collection: 'not_found', fields: 'eyebrow', mode: 'popover' })}
        >
          {notFound.eyebrow}
        </p>
      )}
      <h1
        class="t-display-lg"
        {...editable({ collection: 'not_found', fields: 'heading', mode: 'popover' })}
      >
        {notFound.heading}
      </h1>
      {notFound.body && (
        <p class="t-body-lg" {...editable({ collection: 'not_found', fields: 'body', mode: 'popover' })}>
          {notFound.body}
        </p>
      )}

      <ul class="mt-2 flex flex-wrap gap-2">
        {
          categories.map((category) => (
            <li>
              <a
                href={`/${category.slug}/`}
                class="inline-flex rounded-sharp border border-line px-4 py-2 t-label-md
                       transition-colors hover:border-line-brand hover:text-[color:var(--text-brand-strong)]"
              >
                {category.name}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-4 flex flex-wrap items-center gap-4">
        <Button href="/">{notFound.cta_label}</Button>
        <a href={site.phone_href} class="t-body-md text-ink hover:text-[color:var(--text-brand-strong)]">
          {notFound.phone_label} {site.phone}
        </a>
      </div>
    </div>
  </section>
</Base>
