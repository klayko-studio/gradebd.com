---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { getGallery, getSite, editable } from '../lib/cms';

const [gallery, site] = await Promise.all([getGallery(), getSite()]);
---

<Base seo={gallery.seo} active="gallery">
  <PageBanner
    eyebrow={gallery.banner.eyebrow}
    title={gallery.banner.title}
    sub={gallery.banner.sub}
    lines={gallery.banner.lines}
    image={gallery.banner.image}
    edit={editable({
      collection: 'gallery',
      fields: ['banner_eyebrow', 'banner_lines', 'banner_title', 'banner_sub'],
      mode: 'drawer',
    })}
    editImage={editable({ collection: 'gallery', fields: 'banner_image', mode: 'drawer' })}
  />

  <section class="section">
    <!-- Two columns, as the wireframe specifies. -->
    <div
      class="rail grid gap-6 md:grid-cols-2"
      {...editable({ collection: 'gallery', fields: 'images', mode: 'drawer' })}
      data-reveal-group>
      {
        gallery.images.map((plate) => (
          <figure data-reveal class="group flex flex-col gap-3">
            {/* Comment #32: a slight pop on hover. The plate lifts and the image
                scales inside its own clip, so nothing shifts around it. */}
            <div
              class="overflow-hidden rounded-sharp border border-line-subtle bg-muted-surface
                     transition-[transform,box-shadow,border-color] duration-300 ease-[var(--ease-standard)]
                     group-hover:-translate-y-1 group-hover:border-line-brand
                     group-hover:shadow-[var(--shadow-raised)]"
            >
              <img
                src={plate.image.src}
                alt={plate.image.alt}
                width={plate.image.width}
                height={plate.image.height}
                loading="lazy"
                decoding="async"
                class="aspect-[5/3] w-full object-cover transition-transform duration-500
                       ease-[var(--ease-standard)] group-hover:scale-[1.04]"
              />
            </div>
            <figcaption class="flex flex-wrap items-center justify-between gap-2">
              <span class="t-label-md text-[color:var(--text-primary)]">{plate.caption}</span>
              <span class="t-label-xs text-[color:var(--text-brand-strong)]">{plate.tag}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <QuoteBand
    site={site}
    heading="Want to see a sample before you order?"
    body="Ask for a sample carton and we will arrange it with your quote."
  />
</Base>
