---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHead from '../components/SectionHead.astro';
import { getAbout, editable } from '../lib/cms';

const about = await getAbout();
---

<Base seo={about.seo} active="about">
  <PageBanner
    eyebrow={about.banner.eyebrow}
    title={about.banner.title}
    sub={about.banner.sub}
    lines={about.banner.lines}
    image={about.banner.image}
    edit={editable({
      collection: 'about',
      fields: ['banner_eyebrow', 'banner_lines', 'banner_title', 'banner_sub'],
      mode: 'drawer',
    })}
    editImage={editable({ collection: 'about', fields: 'banner_image', mode: 'drawer' })}
  />

  <!-- Vision then Mission, each on its own row. The wireframe and Figma both set
       them out as separate full-width sections, one under the other — pairing them
       into two columns was our own change and the client asked for it undone. -->
  <section class="section">
    <div class="rail flex flex-col gap-14" data-reveal-group>
      {
        [about.vision, about.mission].map((block, i) => (
          <article
            data-reveal
            id={i === 0 ? 'vision' : 'mission'}
            class="flex flex-col gap-4"
            {...editable({
              collection: 'about',
              fields:
                i === 0
                  ? ['vision_eyebrow', 'vision_heading', 'vision_body']
                  : ['mission_eyebrow', 'mission_heading', 'mission_body'],
              mode: 'drawer',
            })}
          >
            {/*
              The heading is the label now — "Our Vision", "Our Mission" — so the
              eyebrow above it would say the same words twice. Guarded rather than
              deleted: it is still a CMS field, and a moderator who fills it in
              should get it back.
            */}
            {block.eyebrow && <Eyebrow>{block.eyebrow}</Eyebrow>}
            <h2 class="t-heading-lg max-w-[34ch]">{block.heading}</h2>
            {block.body && <p class="t-body-md max-w-[70ch]">{block.body}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section bg-subtle">
    <div class="rail">
      <SectionHead
        eyebrow={about.values_intro.eyebrow}
        heading={about.values_intro.heading}
        edit={editable({
          collection: 'about',
          fields: ['values_intro_eyebrow', 'values_intro_heading'],
        })}
      />
      <div
        class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5"
        data-reveal-group
        {...editable({ collection: 'about', fields: 'values', mode: 'drawer' })}
      >
        {
          about.values.map((value, i) => (
            <div data-reveal class="flex flex-col gap-3 border-t border-line pt-5">
              <p class="t-label-xs text-[color:var(--text-brand-strong)]">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="t-heading-md">{value.title}</h3>
              {value.body && <p class="t-body-sm">{value.body}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div
      class="rail flex flex-col gap-6"
      {...editable({
        collection: 'about',
        fields: ['story_eyebrow', 'story_heading', 'story_body'],
        mode: 'drawer',
      })}
    >
      <Eyebrow data-reveal>{about.story.eyebrow}</Eyebrow>
      <h2 class="t-heading-xl max-w-[34ch]" data-reveal>{about.story.heading}</h2>
      <!-- One column, as drawn. These are four consecutive paragraphs of the client's
           own About text, so splitting them across columns breaks the reading order. -->
      <div class="mt-2 flex flex-col gap-5" data-reveal-group>
        {about.story.body.map((para) => <p class="t-body-md max-w-[70ch]" data-reveal>{para}</p>)}
      </div>
    </div>
  </section>

</Base>
