---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHead from '../components/SectionHead.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { getAbout, getSite } from '../lib/cms';

const [about, site] = await Promise.all([getAbout(), getSite()]);
---

<Base seo={about.seo} active="about">
  <PageBanner
    eyebrow={about.banner.eyebrow}
    title={about.banner.title}
    sub={about.banner.sub}
    lines={about.banner.lines}
    image={about.banner.image}
  />

  <!-- Vision and Mission, paired, in the order the wireframe set out. -->
  <section class="section">
    <div class="rail grid gap-12 md:grid-cols-2 md:gap-16" data-reveal-group>
      {
        [about.vision, about.mission].map((block, i) => (
          <article
            data-reveal
            id={i === 0 ? 'vision' : 'mission'}
            class="flex flex-col gap-4 border-t-2 border-line-brand pt-6"
          >
            <Eyebrow>{block.eyebrow}</Eyebrow>
            <h2 class="t-heading-lg max-w-[26ch]">{block.heading}</h2>
            {block.body && <p class="t-body-md">{block.body}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section bg-subtle">
    <div class="rail">
      <SectionHead eyebrow={about.values_intro.eyebrow} heading={about.values_intro.heading} />
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5" data-reveal-group>
        {
          about.values.map((value, i) => (
            <div data-reveal class="flex flex-col gap-3 border-t border-line pt-5">
              <p class="t-label-xs text-[color:var(--text-brand-strong)]">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="t-heading-md">{value.title}</h3>
              {value.body && <p class="t-body-sm">{value.body}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="rail flex flex-col gap-6">
      <Eyebrow data-reveal>{about.story.eyebrow}</Eyebrow>
      <h2 class="t-heading-xl max-w-[34ch]" data-reveal>{about.story.heading}</h2>
      <div class="mt-2 grid gap-10 md:grid-cols-2 md:gap-16" data-reveal-group>
        {about.story.body.map((para) => <p class="t-body-md" data-reveal>{para}</p>)}
      </div>
    </div>
  </section>

  <QuoteBand
    site={site}
    heading="Planning next term’s stationery order?"
    body={`Send us the list and the quantities. ${site.response_promise}`}
  />
</Base>
