---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductDialog from '../components/ProductDialog.astro';
import { getCategories, getSite, editable } from '../lib/cms';
import type { Category } from '../lib/schema';

/**
 * One route for all five ranges. Adding a sixth category in Directus creates a
 * new page with no code change — which is the whole point of the shared template.
 *
 * Rendered per request rather than from getStaticPaths: a category added in the
 * CMS has to answer immediately, not after the next build.
 */
const slug = Astro.params.category;
const [categories, site] = await Promise.all([getCategories(), getSite()]);
const category = categories.find((entry) => entry.slug === slug);

// An unknown slug is a real 404, not an exception. Rewriting keeps the URL the
// visitor typed while rendering the site's own 404 page.
if (!category) return Astro.rewrite('/404');

/**
 * Sub-category tabs. There is no "All": the first one is the default, so a
 * range always opens on a real group rather than an undifferentiated pile.
 *
 * The active tab comes from `?sub=` rather than living only in JavaScript. The
 * page renders per request, so the server can filter — which means the tabs work
 * with no JavaScript at all, the right group is painted on the first frame
 * instead of flashing the full grid and then narrowing, and a link to one group
 * is a link someone can send. The script below upgrades it to instant switching
 * without a round trip.
 */
const subcategories = category.subcategories;
const requestedSub = Astro.url.searchParams.get('sub');
const activeSub =
  subcategories.find((entry) => entry.slug === requestedSub)?.slug ?? subcategories[0]?.slug ?? null;
---

<Base seo={category.seo} active="categories">
  <PageBanner
    eyebrow={category.name}
    title={category.name}
    sub={category.summary}
    lines={category.banner_lines}
    image={category.image}
    accent={category.accent}
    edit={editable({
      collection: 'categories',
      item: category.directus_id ?? undefined,
      fields: ['name', 'banner_lines', 'summary'],
      mode: 'drawer',
    })}
    editImage={editable({
      collection: 'categories',
      item: category.directus_id ?? undefined,
      fields: 'image',
      mode: 'drawer',
    })}
  />

  <section class="section">
    <div class="rail flex flex-col gap-10">
      {
        subcategories.length > 0 && (
          <nav class="flex flex-wrap gap-x-8 gap-y-3" aria-label={`${category.name} sub-categories`}>
            {subcategories.map((sub) => (
              <a
                href={`?sub=${sub.slug}`}
                class="sub-tab"
                data-sub-tab={sub.slug}
                aria-current={sub.slug === activeSub ? 'true' : undefined}
                style={`--tab-accent:${category.accent}`}
              >
                {sub.name}
                <span aria-hidden="true" class="sub-tab-rule" />
              </a>
            ))}
          </nav>
        )
      }

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group data-item-grid>
        {
          category.items.map((item) => (
            <ProductCard
              name={item.name}
              meta={item.meta}
              image={item.image}
              accent={category.accent}
              action="View product details"
              dialogId={`dlg-${item.id}`}
              edit={editable({
                collection: 'items',
                item: item.directus_id ?? undefined,
                fields: ['name', 'meta', 'image', 'features', 'pack_inner', 'pack_carton'],
                mode: 'drawer',
              })}
              subcategory={item.subcategory}
              class={item.subcategory === activeSub || !activeSub ? '' : 'hidden'}
            />
          ))
        }
      </div>
    </div>
  </section>

  {
    category.items.map((item) => (
      <ProductDialog
        item={item}
        accent={category.accent}
        categoryName={category.name}
        priceNote={site.price_note}
      />
    ))
  }

</Base>

<style>
  /* Text tabs with the range's accent under the active one, as drawn. */
  .sub-tab {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
    transition: color 160ms var(--ease-standard);
  }
  .sub-tab:hover {
    color: var(--text-primary);
  }
  .sub-tab[aria-current='true'] {
    color: var(--text-primary);
    font-weight: 600;
  }
  .sub-tab-rule {
    height: 3px;
    width: 100%;
    border-radius: 999px;
    background: transparent;
    transition: background-color 160ms var(--ease-standard);
  }
  .sub-tab[aria-current='true'] .sub-tab-rule {
    background: var(--tab-accent);
  }
</style>

<script>
  /**
   * Sub-category tabs.
   *
   * They are real links to `?sub=…`, so they already work with the script
   * missing — the server renders the right group. This only upgrades them to
   * switching in place: no round trip, and the URL still updates so the tab
   * survives a reload or a shared link.
   */
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-sub-tab]')];
  const grid = document.querySelector<HTMLElement>('[data-item-grid]');

  if (tabs.length > 0 && grid) {
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-sub]')];

    const select = (slug: string) => {
      for (const tab of tabs) {
        if (tab.dataset.subTab === slug) tab.setAttribute('aria-current', 'true');
        else tab.removeAttribute('aria-current');
      }
      for (const card of cards) card.classList.toggle('hidden', card.dataset.sub !== slug);

      const url = new URL(location.href);
      url.searchParams.set('sub', slug);
      history.replaceState(null, '', url);
    };

    for (const tab of tabs) {
      tab.addEventListener('click', (event) => {
        const slug = tab.dataset.subTab;
        if (!slug) return;
        event.preventDefault();
        select(slug);
      });
    }
  }

  // ---- product detail dialogs
  document.querySelectorAll<HTMLElement>('[data-dialog-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.dataset.dialogOpen;
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.product-dialog').forEach((dialog) => {
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());

    // Clicking the backdrop closes. The dialog element covers the whole viewport,
    // so compare against the inner panel's box rather than the event target.
    dialog.addEventListener('click', (event) => {
      const panel = dialog.firstElementChild;
      if (!(panel instanceof HTMLElement)) return;
      const box = panel.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) dialog.close();
    });

    const main = dialog.querySelector<HTMLImageElement>('[data-dialog-main]');
    const accent = dialog.dataset.dialogAccent ?? 'currentColor';
    const thumbs = dialog.querySelectorAll<HTMLButtonElement>('[data-dialog-thumb]');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        if (!main) return;
        main.src = thumb.dataset.dialogThumb ?? main.src;
        main.alt = thumb.dataset.dialogThumbAlt ?? main.alt;
        thumbs.forEach((other) => {
          other.style.borderColor = other === thumb ? accent : 'transparent';
        });
      });
    });
  });

</script>
