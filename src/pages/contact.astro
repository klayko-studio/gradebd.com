---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { getContact, getSite, editable } from '../lib/cms';

const [contact, site] = await Promise.all([getContact(), getSite()]);

/* Item cards link here with ?item=… so the enquiry arrives pre-filled. The query
   string is only known in the browser — see the script below. */

const field =
  'w-full rounded-sharp border border-line bg-page px-5 py-4 t-body-md text-ink ' +
  'transition-colors placeholder:text-[color:var(--text-muted)] focus:border-line-brand focus:outline-none';
---

<Base seo={contact.seo} active="contact">
  <PageBanner
    eyebrow={contact.banner.eyebrow}
    title={contact.banner.title}
    sub={contact.banner.sub}
    lines={contact.banner.lines}
    image={contact.banner.image}
    edit={editable({
      collection: 'contact',
      fields: ['banner_eyebrow', 'banner_lines', 'banner_title', 'banner_sub'],
      mode: 'drawer',
    })}
    editImage={editable({ collection: 'contact', fields: 'banner_image', mode: 'drawer' })}
  />

  <!-- ── enquiry form ──────────────────────────────────────────────────────
       Laid out as the client drew it: the three short fields stacked in a left
       column with the message filling the full height beside them, and one wide
       Send button centred underneath.

       The labels live inside the fields, which is what the drawing asks for. They
       are still real <label> elements, visually hidden — a placeholder disappears
       the moment someone types, and a form whose fields lose their names as they
       are filled in is unusable with a screen reader. -->
  <section class="section">
    <div class="rail flex flex-col gap-6">
      <Eyebrow>{contact.form_eyebrow}</Eyebrow>
      <h2
        class="t-heading-xl"
        {...editable({ collection: 'contact', fields: 'form_heading', mode: 'popover' })}
      >
        {contact.form_heading}
      </h2>
      {
        contact.form_sub && (
          <p
            class="t-body-md max-w-[70ch] text-[color:var(--text-secondary)]"
            {...editable({ collection: 'contact', fields: 'form_sub', mode: 'popover' })}
          >
            {contact.form_sub}
          </p>
        )
      }

      <form id="enquiry" class="mt-4 flex flex-col gap-5" novalidate>
        <div class="grid gap-5 lg:grid-cols-2">
          <div class="flex flex-col gap-5">
            <div class="flex flex-col gap-2">
              <label for="name" class="sr-only">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder={contact.field_name_label}
                required
                class={field}
              />
              <p class="t-label-sm text-[color:var(--text-brand-strong)]" data-error="name" hidden></p>
            </div>

            <div class="flex flex-col gap-2">
              <label for="email" class="sr-only">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder={contact.field_email_label}
                required
                class={field}
              />
              <p class="t-label-sm text-[color:var(--text-brand-strong)]" data-error="email" hidden></p>
            </div>

            <div class="flex flex-col gap-2">
              <label for="phone" class="sr-only">Mobile number</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                placeholder={contact.field_phone_label}
                required
                class={field}
              />
              <p class="t-label-sm text-[color:var(--text-brand-strong)]" data-error="phone" hidden></p>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="requirement" class="sr-only">Message</label>
            {/* h-full so the message box matches the three fields beside it, which
                is what makes the two columns read as one block rather than two. */}
            <textarea
              id="requirement"
              name="requirement"
              placeholder={contact.field_message_label}
              required
              class={`${field} h-full min-h-[200px] resize-y`}></textarea>
            <p
              class="t-label-sm text-[color:var(--text-brand-strong)]"
              data-error="requirement"
              hidden></p>
          </div>
        </div>

        <!-- Bots fill this; humans never see it. -->
        <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
          <label for="honeypot">Leave this field empty</label>
          <input id="honeypot" name="honeypot" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="mt-4 flex justify-center">
          <button
            type="submit"
            class="group inline-flex w-full max-w-[420px] items-center justify-center gap-4 rounded-sharp
                   bg-brand px-8 py-4 t-button text-[color:var(--text-on-brand)]
                   transition-colors duration-200 hover:bg-brand-hover
                   disabled:pointer-events-none disabled:opacity-60"
          >
            {contact.send_label}
            <svg
              width="26"
              height="12"
              viewBox="0 0 26 12"
              fill="none"
              aria-hidden="true"
              class="transition-transform duration-200 group-hover:translate-x-1"
            >
              <path
                d="M0 6h24M19 1l5 5-5 5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>

        <p
          role="status"
          aria-live="polite"
          class="mx-auto max-w-[560px] rounded-sharp border px-4 py-3.5 text-center t-body-sm"
          data-form-status
          hidden
        >
        </p>
      </form>
    </div>
  </section>

  <!-- ── visit or call ─────────────────────────────────────────────────────
       The map sits beside the address again, as drawn. It had been moved out to
       its own full-width band (comment #38); this layout supersedes that. -->
  <section class="section pt-0">
    <div class="rail flex flex-col gap-8">
      <Eyebrow accent="var(--color-accent-cyan)">{contact.visit_eyebrow}</Eyebrow>

      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div class="flex flex-col gap-5">
          <h2 class="t-heading-md" {...editable({ collection: 'contact', fields: 'office_heading', mode: 'popover' })}>{contact.office_heading}</h2>
          <address class="flex flex-col gap-1.5 t-body-md not-italic">
            <span class="text-ink">{site.company_name}</span>
            {site.address_lines.map((line) => <span>{line}</span>)}
          </address>
          <div class="flex flex-col gap-1.5">
            <a
              href={site.phone_href}
              class="t-body-md text-ink hover:text-[color:var(--text-brand-strong)]"
            >
              {site.phone}
            </a>
            <a
              href={`mailto:${site.email}`}
              class="t-body-md text-ink hover:text-[color:var(--text-brand-strong)]"
            >
              {site.email}
            </a>
            <p class="t-body-sm text-[color:var(--text-muted)]">{site.opening_hours}</p>
          </div>
        </div>

        <div
          class="flex flex-col gap-5"
          {...editable({ collection: 'contact', fields: 'map_embed_url', mode: 'drawer' })}
        >
          <h2 class="t-heading-md" {...editable({ collection: 'contact', fields: 'map_heading', mode: 'popover' })}>{contact.map_heading}</h2>
          {
            contact.map_embed_url ? (
              <iframe
                src={contact.map_embed_url}
                title="Grade Limited head office on Google Maps"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="aspect-[2.2/1] w-full rounded-sharp border border-line"
              />
            ) : (
              /* No embed URL set yet, so this is a labelled placeholder rather than
                 an empty iframe or a third-party request nobody consented to. */
              <div
                class="flex aspect-[2.2/1] w-full flex-col items-center justify-center gap-1 rounded-sharp
                       border border-line bg-muted-surface px-6 text-center"
              >
                <p class="t-label-md text-[color:var(--text-secondary)]">Google Map embed</p>
                <p class="t-label-sm text-[color:var(--text-muted)]">{site.address_lines.join(' ')}</p>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────────────
       The pill is a label, not a control: every question is on the page from the
       start and each opens on its own. That replaces the single show/hide button
       from comment #37, which this design supersedes.

       Whether the section appears at all is a switch in the CMS (`show_faqs`),
       currently off. The questions are still there — turning it back on is one
       toggle, not a rebuild. -->
  {
    contact.show_faqs && (
  <section class="section pt-0">
    <div class="rail flex flex-col gap-10">
      {/* font-sans explicitly: this is an <h2>, and headings inherit the display
          serif, but the drawing sets this pill in the interface face. */}
      <h2
        class="self-center rounded-full bg-inverse px-7 py-3 font-sans t-label-md
               text-[color:var(--text-inverse)]"
      >
        {contact.faq_heading}
      </h2>

      <div
        class="border-t border-line-subtle"
        data-reveal
        {...editable({ collection: 'contact', fields: 'faqs', mode: 'drawer' })}
      >
        {
          contact.faqs.map((faq) => (
            <details class="group border-b border-line-subtle">
              <summary
                class="flex cursor-pointer list-none items-center gap-6 py-6 t-heading-sm
                       transition-colors hover:text-[color:var(--text-brand-strong)]"
              >
                <span class="grow">{faq.question}</span>
                {/* Two bars: the upright one rotates flat, so + becomes −. */}
                <span
                  aria-hidden="true"
                  class="relative h-3.5 w-3.5 shrink-0 text-[color:var(--text-brand-strong)]"
                >
                  <span class="absolute top-1/2 left-0 h-[1.5px] w-3.5 -translate-y-1/2 bg-current" />
                  <span
                    class="absolute top-1/2 left-0 h-[1.5px] w-3.5 -translate-y-1/2 rotate-90 bg-current
                           transition-transform duration-200 group-open:rotate-0"
                  />
                </span>
              </summary>
              <p class="max-w-[80ch] pb-6 t-body-md">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
    )
  }
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#enquiry');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  /* Prefill from ?item=… — a product card sent the buyer here about one line item. */
  const requirement = form?.querySelector<HTMLTextAreaElement>('#requirement');
  const item = new URLSearchParams(location.search).get('item');
  if (requirement && item && !requirement.value.trim()) {
    // Cap the length so a crafted URL can't stuff the field with junk.
    requirement.value = `I'd like a quote for: ${item.slice(0, 120)}\nQuantity: `;
    requirement.setSelectionRange(requirement.value.length, requirement.value.length);
  }

  function setStatus(message: string, kind: 'ok' | 'error' | 'busy') {
    if (!status) return;
    status.hidden = false;
    status.textContent = message;
    status.style.borderColor =
      kind === 'error'
        ? 'var(--border-brand)'
        : kind === 'ok'
          ? 'var(--border-default)'
          : 'var(--border-subtle)';
    status.style.background = kind === 'error' ? 'var(--bg-brand-subtle)' : 'var(--bg-subtle)';
    status.style.color = kind === 'error' ? 'var(--text-brand-strong)' : 'var(--text-primary)';
  }

  function fieldError(name: string) {
    return form?.querySelector<HTMLElement>(`[data-error="${name}"]`) ?? null;
  }

  function hideError(name: string) {
    const el = fieldError(name);
    if (!el) return;
    el.hidden = true;
    el.textContent = '';
    const input = form?.querySelector<HTMLElement>(`[name="${name}"]`);
    input?.removeAttribute('aria-invalid');
    input?.removeAttribute('aria-describedby');
  }

  function showError(name: string, message: string) {
    const el = fieldError(name);
    const input = form?.querySelector<HTMLElement>(`[name="${name}"]`);
    if (!el) return;
    el.hidden = false;
    el.textContent = message;
    if (input) {
      input.setAttribute('aria-invalid', 'true');
      // The message has an id so a screen reader reads it with the field.
      if (!el.id) el.id = `error-${name}`;
      input.setAttribute('aria-describedby', el.id);
    }
  }

  function clearErrors() {
    form
      ?.querySelectorAll<HTMLElement>('[data-error]')
      .forEach((el) => hideError(el.dataset.error ?? ''));
  }

  /* Clear a field's error as soon as the buyer starts correcting it — leaving a
     stale message under a field they have already fixed reads as a broken form. */
  form?.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
    const name = el.dataset.error;
    if (!name) return;
    form
      .querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`)
      ?.addEventListener('input', () => {
        if (!el.hidden) hideError(name);
      });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearErrors();

    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    setStatus('Sending your enquiry…', 'busy');

    const payload = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch('/api/enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as {
        ok: boolean;
        message: string;
        errors?: Record<string, string[]>;
      };

      if (!res.ok || !data.ok) {
        // Field errors land next to their field, not in a summary at the top.
        if (data.errors) {
          for (const [name, messages] of Object.entries(data.errors)) {
            if (messages[0]) showError(name, messages[0]);
          }
          // Send focus to the first field that needs attention.
          const first = Object.keys(data.errors)[0];
          form.querySelector<HTMLElement>(`[name="${first}"]`)?.focus();
        }
        setStatus(data.message ?? 'Something went wrong. Please try again.', 'error');
        return;
      }

      form.reset();
      setStatus(data.message, 'ok');
    } catch {
      setStatus(
        'We could not reach the server. Please email info@gradebd.com or call 01842-024378.',
        'error',
      );
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
