---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import ScrollTop from '../components/ScrollTop.astro';
import { getSite, getCategories, visualEditingEnabled, DIRECTUS_PUBLIC_URL } from '../lib/cms';
import type { Seo } from '../lib/schema';

interface Props {
  seo: Seo;
  /** Which nav item is the current page. */
  active?: 'home' | 'about' | 'categories' | 'gallery' | 'contact';
  /** Extra schema.org objects for this page, e.g. the Contact page's FAQPage. */
  jsonLd?: Record<string, unknown>[];
}

const { seo, active, jsonLd = [] } = Astro.props;
const site = await getSite();
const categories = await getCategories();
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.gradebd.com').href;

/** The share picture: the page's own if it has one, otherwise the site default. */
const shareImage = site.og_image?.src
  ? new URL(site.og_image.src, Astro.site ?? 'https://www.gradebd.com').href
  : null;
const favicon = site.favicon?.src ?? null;
/**
 * From the file's own media type, not the URL: a proxied `/cms/<id>` has no
 * extension to read. The filename fallback covers the seed path, which does.
 */
/**
 * The page background, from the CMS. Injected as a custom property rather than
 * an inline style on an element, because the artwork is painted by
 * `body::before` in the stylesheet — a pseudo-element nothing can reach from the
 * markup. An unset one falls back to the file in global.css.
 */
const backgroundImage = site.background_image?.src
  ? `url('${site.background_image.src}')`
  : null;

/**
 * Structured data. Google's own summary of the company is built from whatever
 * it can find, and today that is the old Facebook/LinkedIn copy calling Grade a
 * "B2B marketplace". Stating who the company is, in the site's own words, on
 * every page gives it a first-party source to prefer. Sitelinks under the result
 * are Google's choice, but a named WebSite plus a clear menu is what it reads.
 */
const origin = (Astro.site ?? new URL('https://www.gradebd.com')).href;
const absolute = (src?: string | null) => (src ? new URL(src, origin).href : undefined);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${origin}#organization`,
    name: site.company_name,
    alternateName: ['Grade', 'Grade Ltd', 'Grade Stationery'],
    url: origin,
    logo: absolute(site.logo?.src),
    slogan: site.tagline || undefined,
    description: site.seo?.description || seo.description,
    foundingDate: String(site.founded_year),
    email: site.email || undefined,
    telephone: site.phone_href?.replace(/^tel:/, '') || site.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address_lines.slice(0, -1).join(', '),
      addressLocality: 'Dhaka',
      postalCode: '1205',
      addressCountry: 'BD',
    },
    sameAs: site.socials.filter((s) => s.confirmed && s.url).map((s) => s.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${origin}#website`,
    name: site.company_name,
    alternateName: 'Grade Stationery',
    url: origin,
    publisher: { '@id': `${origin}#organization` },
  },
  ...jsonLd,
];

const faviconType =
  site.favicon?.mime ?? (favicon?.toLowerCase().endsWith('.svg') ? 'image/svg+xml' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {seo.noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.company_name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    <meta name="theme-color" content="#0d2038" />

    {/* Both from the CMS. Without one, the browser falls back to /favicon.ico. */}
    {/* The type matters: without it a browser will not treat an SVG as an icon,
        and Safari in particular falls back to the default tab mark. */}
    {backgroundImage && <style set:html={`:root{--site-background:${backgroundImage}}`} />}
    {favicon && <link rel="icon" href={favicon} type={faviconType} />}
    {favicon && <link rel="apple-touch-icon" href={favicon} />}

    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/raleway-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    ))}

    <script is:inline>
      // Mark JS as available before first paint so reveal-on-scroll elements can
      // start hidden. Without this class everything is visible, which is what a
      // no-JS visitor should get rather than a blank page.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body data-directus-url={visualEditingEnabled ? DIRECTUS_PUBLIC_URL : undefined}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-brand focus:px-4 focus:py-2 focus:text-[color:var(--text-on-brand)]"
    >
      Skip to content
    </a>

    <Header site={site} categories={categories} active={active} />

    <!-- One search dialog per page, mounted here rather than inside the header:
         the header is `sticky` and a modal dialog inside a positioned ancestor is
         at the mercy of how the browser resolves its containing block. It is only
         rendered when the control that opens it exists. -->
    {site.show_search && <SearchDialog categories={categories} />}

    <!-- The splash is the site's background now, painted once on the body — see
         global.css. Nothing to opt into here. -->
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer site={site} categories={categories} showSocials={active !== 'home'} />

    <!-- Floating "back to top", on every page. A sibling of the footer for the
         same containing-block reason the WhatsApp button is one. -->
    <ScrollTop />

    <script>
      import '../scripts/motion';
    </script>

    {
      /*
       * Directus Visual Editing. The module dynamic-imports the library only
       * when the page is inside the admin's iframe, so Vite splits it into its
       * own chunk and an ordinary visitor never downloads it.
       */
      visualEditingEnabled && <script>import '../scripts/visual-editing';</script>
    }

  </body>
</html>
