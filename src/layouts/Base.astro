---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite, getCategories, visualEditingEnabled, DIRECTUS_PUBLIC_URL } from '../lib/cms';
import type { Seo } from '../lib/schema';

interface Props {
  seo: Seo;
  /** Which nav item is the current page. */
  active?: 'home' | 'about' | 'categories' | 'gallery' | 'contact';
}

const { seo, active } = Astro.props;
const site = await getSite();
const categories = await getCategories();
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.gradebd.com').href;

/** The share picture: the page's own if it has one, otherwise the site default. */
const shareImage = site.og_image?.src
  ? new URL(site.og_image.src, Astro.site ?? 'https://www.gradebd.com').href
  : null;
const favicon = site.favicon?.src ?? null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {seo.noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.company_name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    <meta name="theme-color" content="#0d2038" />

    {/* Both from the CMS. Without one, the browser falls back to /favicon.ico. */}
    {favicon && <link rel="icon" href={favicon} />}
    {favicon && <link rel="apple-touch-icon" href={favicon} />}

    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/raleway-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <script is:inline>
      // Mark JS as available before first paint so reveal-on-scroll elements can
      // start hidden. Without this class everything is visible, which is what a
      // no-JS visitor should get rather than a blank page.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body data-directus-url={visualEditingEnabled ? DIRECTUS_PUBLIC_URL : undefined}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-brand focus:px-4 focus:py-2 focus:text-[color:var(--text-on-brand)]"
    >
      Skip to content
    </a>

    <Header site={site} categories={categories} active={active} />

    <!-- The splash is the site's background now, painted once on the body — see
         global.css. Nothing to opt into here. -->
    <main id="main">
      <slot />
    </main>

    <Footer site={site} categories={categories} showSocials={active !== 'home'} />

    <script>
      import '../scripts/motion';
    </script>

    {
      /*
       * Directus Visual Editing. The module dynamic-imports the library only
       * when the page is inside the admin's iframe, so Vite splits it into its
       * own chunk and an ordinary visitor never downloads it.
       */
      visualEditingEnabled && <script>import '../scripts/visual-editing';</script>
    }

  </body>
</html>
