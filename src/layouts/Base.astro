---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite, getCategories } from '../lib/cms';
import type { Seo } from '../lib/schema';

interface Props {
  seo: Seo;
  /** Which nav item is the current page. */
  active?: 'home' | 'about' | 'categories' | 'gallery' | 'contact';
}

const { seo, active } = Astro.props;
const site = await getSite();
const categories = await getCategories();
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.gradebd.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {seo.noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.company_name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d2038" />

    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/raleway-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <script is:inline>
      // Mark JS as available before first paint so reveal-on-scroll elements can
      // start hidden. Without this class everything is visible, which is what a
      // no-JS visitor should get rather than a blank page.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-brand focus:px-4 focus:py-2 focus:text-[color:var(--text-on-brand)]"
    >
      Skip to content
    </a>

    <Header site={site} categories={categories} active={active} />

    <main id="main">
      <slot />
    </main>

    <Footer site={site} categories={categories} />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reduced) {
        // Respect the preference: show everything, animate nothing.
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        gsap.registerPlugin(ScrollTrigger);

        // Group siblings that share a parent so a row of cards staggers together
        // rather than each card firing its own trigger.
        const groups = new Map<Element, HTMLElement[]>();
        targets.forEach((el) => {
          const key = el.closest('[data-reveal-group]') ?? el.parentElement ?? document.body;
          const list = groups.get(key) ?? [];
          list.push(el);
          groups.set(key, list);
        });

        groups.forEach((els) => {
          gsap.to(els, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            ease: 'power3.out',
            stagger: 0.07,
            scrollTrigger: { trigger: els[0], start: 'top 88%', once: true },
            onStart: () => els.forEach((el) => el.classList.add('is-revealed')),
          });
        });
      }
    </script>
  </body>
</html>
